		<ASSEMBLYREFS><![CDATA[]]></ASSEMBLYREFS>
		<PROGRAM_SOURCE><![CDATA[using System;
using System.Net.Mail;

class OTS_MAIL
{
	private string  m_outgoing_mail_server;
	private string  m_outgoing_mail_account;

	public OTS_MAIL(string outgoing_mail_server, string outgoing_mail_account)
	{
		m_outgoing_mail_server	= outgoing_mail_server;
		m_outgoing_mail_account	= outgoing_mail_account;
	}

	private void SendMail(string recipients, string subject, string body, bool html, params object[] attachments)
	{
		MailMessage message = new MailMessage();
		foreach (string recipient in recipients.Split(new [] {";"}, StringSplitOptions.RemoveEmptyEntries))
			message.To.Add(recipient);    
		message.Subject = subject;
		message.From = new System.Net.Mail.MailAddress(m_outgoing_mail_account);
		message.IsBodyHtml = html;
		message.Body = body;
		if( attachments != null )
			foreach (string attachment in attachments)
				message.Attachments.Add(new Attachment(attachment));

		SmtpClient smtp = new SmtpClient(m_outgoing_mail_server);
		smtp.Send(message);
	}

	public void SendMail(string recipients, string subject, string body, params object[] attachments)
	{
		SendMail(recipients, subject, body, false, attachments);
	}

	public void SendMailHtml(string recipients, string subject, string body, params object[] attachments)
	{
		SendMail(recipients, subject, body, true, attachments);
	}
}]]></PROGRAM_SOURCE>
