	<T_RDMI_METHOD COMPONENT_NAME="OTS_CALENDAR" METHOD_NAME="CONVERTTOPATTERN" METHOD_SEQNO="1" INTERFACE="N" MODULE="" INTERFACE_CORRECT="Y" CREATED_BY="USD_COMPONENTS61" CREATED_ON="2002-08-09T09:52:33">
		<PHYSICAL_METHOD_NAME><![CDATA[sdf=new java.text.SimpleDateFormat()  
sdf.applyPattern((U):1)  
sdf.format((Date):0)]]></PHYSICAL_METHOD_NAME>
		<DESCRIPTION><![CDATA[Converts the input date according to pattern but does not change style settings of the current date of the calendar instance. 

PATTERNS: 
Symbol   Meaning                    Example  
 ------     -------                             -------  
 G        era designat                 AD  
 y         year                             1996  
 M        month in year               July & 07  
 d         day in month                10  
 h         hour in am/pm (1~12)  12  
 H         hour in day (0~            0  
 m         minute in hour             30  
 s          second in minute         55  
 S          millisecond                  978  
 E          day in week                Tuesday  
 D          day in year                  189  
 F          day of week in month   2 (2nd Wed in July)  
 w          week in year                27  
 W         week in month             2  
 a          am/pm marker              PM  
 k          hour in day (1~24)        24  
 K          hour in am/pm (0~11)  0  
 z          time zone                      Pacific Standard Time  
 '           escape for text         
 ''          single quote                  ']]></DESCRIPTION>
	</T_RDMI_METHOD>
