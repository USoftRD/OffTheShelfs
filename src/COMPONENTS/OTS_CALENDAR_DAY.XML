	};
	public OTS_CALENDAR_DAY(string cult_str, string month_name_fmt, string day_name_fmt, string period_start, string period_end, double days_step)
	{
		m_cult_str = m_default_cult_str = string.IsNullOrEmpty(cult_str) ? CultureInfo.CurrentCulture.Name : cult_str;
		m_month_name_fmt = month_name_fmt;
		m_day_name_fmt = day_name_fmt;
		m_period_start_str =  m_period_default_start_str = period_start;
		m_period_end_str = m_period_default_end_str = period_end;
		m_days_step = days_step == 0 ? 1 : days_step;
		m_default_cult = m_cult = new CultureInfo(m_cult_str);
	}
	private bool ParseDateTime(XElement el, ref DateTime dt, ref string used_date_str)
	{
		if(el!=null && el.Value!=null)
		{
			string op = el.Attribute("name")==null ? null : el.Attribute("name").Value;
			if(!"=".Equals(op))
			{
				throw new Exception(string.Format("Operator {0} can not be used for period start or end, only literal date values can be used", op));
			}
			string col_name = el.XPathSelectElement("Column").Attribute("name").Value;
			if(ParseDateExpr(el.Value, ref dt, col_name))
			{
				used_date_str = el.Value;
			}
			else
			{
				dt = ParseDateTime(el.Value, ref used_date_str);
			}
			return true;
		}
		return false;
	}
	private DateTime ParseDateTime(string date_str)
	{
		string ref_null = null;
		return ParseDateTime(date_str, ref ref_null);
	}
	private DateTime ParseDateTime(string date_str, ref string used_date_str)
	{
		DateTime dt = DateTime.Now;
		if(!string.IsNullOrEmpty(date_str))
		{
			if (DateTime.TryParseExact(date_str, m_formats, m_default_cult, DateTimeStyles.AllowWhiteSpaces, out dt))
			{
				if(used_date_str!=null) used_date_str = date_str;
				return dt;
			}
		}
		throw new Exception(string.Format("Failed to parse {0}, possible formats are: {1}", date_str, ListFormats()));
	}
	private bool ParseYearCondition(XElement el, ref int start_year, ref int last_year)
	{
		if(el == null)
		{
			return false;
		}
		string op = el.Attribute("name")==null ? null : el.Attribute("name").Value;
		string year_str = el.Element("Value")==null? null : el.Element("Value").Value;
		if(op==null || year_str==null)
		{
			return false;
		}
		switch(op)
		{
			case "=":
				start_year = int.Parse(year_str);
				last_year = start_year;
			break;
			case "&gt;":
				start_year = int.Parse(year_str) + 1;	
			break;
			case "&gt;=":
				start_year = int.Parse(year_str);
			break;
			case "&lt;":
				last_year = int.Parse(year_str) - 1;
			break;
			case "&lt;=":
				last_year = int.Parse(year_str) ;
			break;
			default: return false;
			break;
		}
		return true;
	}
	public int RowsetSize()
	{
		m_period_start = ParseDateTime(m_period_start_str);
		m_period_end = ParseDateTime(m_period_end_str);
		return (int)((m_period_end - m_period_start).TotalDays / m_days_step);
	}
	public int QueryExe(string query_conditions)
	{
		m_period_start_str = m_period_default_start_str;
		m_period_end_str = m_period_default_end_str;
		m_period_start = ParseDateTime(m_period_start_str);
		m_period_end = ParseDateTime(m_period_end_str);
		m_cult_str = m_default_cult_str;
		m_cult = m_default_cult;
		bool has_query_conditions = false; 
		XDocument qc = null;
		try
		{
			qc = XDocument.Parse(query_conditions); 
			has_query_conditions = true;
		}
		catch(Exception) {};
		if(has_query_conditions)
		{
			ParseDateTime(qc.XPathSelectElement("/SqlNode//Operator[Column[@name='PERIOD_START']]"), ref m_period_start, ref m_period_start_str);
			ParseDateTime(qc.XPathSelectElement("/SqlNode//Operator[Column[@name='PERIOD_END']]"), ref m_period_end, ref m_period_end_str);
			int start_year = m_period_start.Year;
			int last_year = m_period_end.Year;
			if (ParseYearCondition(qc.XPathSelectElement("/SqlNode//Operator[Column[@name='YEAR']]"), ref start_year, ref last_year))
			{
				if(m_period_start < new DateTime(start_year, 01, 01))
				{
					m_period_start = new DateTime(start_year, 01, 01);
				}
				if(m_period_end > new DateTime(last_year, 12, 31))
				{
					m_period_end = new DateTime(start_year, 12, 31);
				}
			}
			XElement cult_el = qc.XPathSelectElement("/SqlNode//Operator[Column[@name='CULTURE_NAME']]");
			if(cult_el!=null && cult_el.Value !=null)
			{
				string op = cult_el.Attribute("name")==null ? null : cult_el.Attribute("name").Value;
				if(!"=".Equals(op))
				{
					throw new Exception("Operator " + op + " not supported to specify a culture.");
				}
				m_cult_str = (string)cult_el.Value;
			}	
		}
		try
		{
			if(!m_default_cult_str.Equals(m_cult_str))
			{
				m_cult = new CultureInfo(m_cult_str);
			}
			m_first_day_of_week = m_cult.DateTimeFormat.FirstDayOfWeek;
			m_last_day_of_week = m_cult.LCID == 1033 /*En-us*/ ? DayOfWeek.Saturday : DayOfWeek.Sunday;
		}
		catch(Exception e)
		{
			throw new Exception(string.Format("Culture name {0} not valid: {1}. Valid culture names: {2}", m_cult_str, e.Message, ListCultures()));
		}
		m_dt_iterate = m_days_step > 0 ? m_period_start : m_period_end;
		return 1;
	}
	public int QueryFetch(out string period_start, out string period_end, out string cult_name, out int year, out int month_no, out int day_no, out int week_no, out int day_of_week, out int day_of_year, out string month_name, out string day_name)
	{
		period_start = m_period_start_str;
		period_end = m_period_end_str;
		cult_name = m_cult_str;
		day_of_week = (int)m_dt_iterate.DayOfWeek;
		year = m_dt_iterate.Year;
		DateTime last_day_of_year = new DateTime(year, 12, 31);
		// ISO8601 week number
		week_no = m_cult.Calendar.GetWeekOfYear(m_dt_iterate, m_cult.DateTimeFormat.CalendarWeekRule, m_first_day_of_week);
		week_no = week_no == 53 && last_day_of_year.DayOfWeek != m_last_day_of_week ? 1 : week_no;
		day_of_year = m_dt_iterate.DayOfYear;
		month_no = m_dt_iterate.Month;
		day_no = m_dt_iterate.Day;
		month_name = m_dt_iterate.ToString(m_month_name_fmt, m_cult);
		day_name = m_dt_iterate.ToString(m_day_name_fmt, m_cult);
		if(m_dt_iterate > m_period_end || m_dt_iterate < m_period_start)
		{
			return 0;
		}
		m_dt_iterate = m_dt_iterate.AddDays(m_days_step);
		return 1;
	}
	public string AddDays(string date_str, double num_days, string format)
	{
		if(string.IsNullOrEmpty(format))
		{
			format = @"yyyy\/MMddHHmmss";
		}
		DateTime dt = DateTime.Now;
		if(!string.IsNullOrEmpty(date_str))
		{
			dt = ParseDateTime(date_str);
		}
		dt = dt.AddDays(num_days);
		return dt.ToString(format, m_default_cult);
	}
	public double DaysBetween(string date_str1, string date_str2)
	{
		DateTime dt1 = DateTime.Now, dt2 = DateTime.Now;
		if(!string.IsNullOrEmpty(date_str1))
		{
			dt1 = ParseDateTime(date_str1);
		}
		if(!string.IsNullOrEmpty(date_str2))
		{
			dt2 = ParseDateTime(date_str2);
		}
		TimeSpan span = dt2.Subtract(dt1);
		return Math.Round(span.TotalDays, 3); // loss of precision for fractions
	}
	public string ListCultures()
	{
		System.Text.StringBuilder result = new System.Text.StringBuilder();
		CultureInfo[] cinfo = CultureInfo.GetCultures(CultureTypes.AllCultures & ~CultureTypes.NeutralCultures);
		foreach (CultureInfo cul in cinfo)
        {
            result.Append(cul.Name + "\t\t" + cul.DisplayName + Environment.NewLine );
        }
		return result.ToString();
	}
	public string ListFormats()
	{
		System.Text.StringBuilder result = new System.Text.StringBuilder();
		foreach (string fmt in m_formats)
        {
            result.Append(fmt + Environment.NewLine);
        }
		return result.ToString();
	}
	private DateTime FirstDayOfWeek(DateTime dt)
	{
		var diff = dt.DayOfWeek - m_first_day_of_week;
        diff = (diff < 0) ? diff + 7 : diff;
        return dt.AddDays(-diff);
	}
	private readonly Regex DateExProp = 
		new Regex(	@"^(now|next|following|last|previous|preceding|this|soy|start\s*of\s*year|year\*start|eoy|end\s*of\s*year|year\s*end|yesterday|tomorrow|sow|start\s*of\s*week|eow|end\s*of\s*week|som|start\s*of\s*month)?((?<=next|following|last|previous|preceding|this)\s*[\w]*)?\s*(plus|\+|minus|\-)?((?<=plus|\+|minus|\-)\s*[\w\.]*)?\s*(years|year|months|month|weeks|week|days|day)?\s*$",
					RegexOptions.IgnoreCase);

	private bool ParseDateExpr(string expr, ref DateTime dt, string elname)
	{
		bool result = true;
		Match m = DateExProp.Match(expr);
		if(!m.Success || m.Groups.Count < 6 || string.IsNullOrWhiteSpace(m.Groups[0].Value))
		{
			return false;
		}
		string op1 = m.Groups[1].Value.Trim();
		string op2 = m.Groups[2].Value.Trim();
		string op3 =  m.Groups[3].Value.Trim();
		string op4 =  m.Groups[4].Value.Trim();
		string op5 =  m.Groups[5].Value.Trim();
		switch(op1.ToLower().Replace(" ", string.Empty))
		{
			case "now":
				dt = DateTime.Now;
			break;
			case "soy": case "startofyear": case "yearstart":
				dt = new DateTime(DateTime.Now.Year, 01, 01);
			break;
			case "eoy": case "endofyear": case "yearend":
				dt = new DateTime(DateTime.Now.Year, 12, 31);
			break;
			case "yesterday": 
				dt = DateTime.Now.AddDays(-1);
			break;
			case "tomorrow": 
				dt = DateTime.Now.AddDays(1);
			break;
			case "sow": case "startofweek": case "start of week":
				dt = FirstDayOfWeek(DateTime.Now);
			break;
			case "eow": case "endofweek": case "end of week":
				dt = FirstDayOfWeek(DateTime.Now).AddDays(6);
			break;
			case "som": case "startofmonth":
				dt = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
			break;
			case "eom": case "endofmonth":
				dt = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1);
			break;
			case "this":
				{
					DayOfWeek dow;
					if(Enum.TryParse(op2, true, out dow))
					{
						int day_still = ((int)dow - (int)DateTime.Now.DayOfWeek + 7) % 7;
						dt = DateTime.Now.AddDays(day_still);
					}
					else
					{
						dt = ThisDate(op2, DateTime.Now, elname);
					}
				}
			break;
			case "next": case "following":
				{
					DayOfWeek dow;
					dt = DateTime.Now;
					bool isday_name = Enum.TryParse(op2, true, out dow);
					if(isday_name)
					{
						int days_till = ((int)dow - (int)dt.DayOfWeek + 7) % 7;
						dt = dt.AddDays(days_till);
						op2 = "week";
					}
					if(!AddUnit(ref dt, "1", op2, 1))
					{
						throw new Exception(string.Format("Unit invalid in {0}", op2));
					}
					if(!isday_name) dt = ThisDate(op2, dt, elname);
				}
			break;
			case "last":
				{
					DayOfWeek dow;
					dt = DateTime.Now;
					bool is_day_name = Enum.TryParse(op2, true, out dow);
					if(is_day_name)
					{
						int days_till = ((int)dow - (int)dt.DayOfWeek - 7) % 7;
						dt = dt.AddDays(days_till);
						op2 = "week";
					}
					if(!AddUnit(ref dt, "1", op2, -1))
					{
						throw new Exception(string.Format("Unit invalid in {0}", op2));
					}
					if (!is_day_name) dt = ThisDate(op2, dt, elname);
				}
			break;
			case "previous": case "preceding":
				{
					DayOfWeek dow;
					dt = DateTime.Now;
					bool is_day_name = Enum.TryParse(op2, true, out dow);
					if(is_day_name)
					{
						int days_till = ((int)dow - (int)DateTime.Now.DayOfWeek - 7) % 7;
						dt = DateTime.Now.AddDays(days_till);
					}
					else
					{
						if(!AddUnit(ref dt, "1", op2, -1))
						{
							throw new Exception(string.Format("Unit invalid in {0}", op2));
						}
						dt = ThisDate(op2, dt, elname);
					}
				}
			break;
			default:
					if(string.IsNullOrWhiteSpace(op3) && string.IsNullOrWhiteSpace(op4))
					{
						return false;
					}
					dt = DateTime.Now;
			break;
		}
		switch(op3)
		{
			case "plus": case "+":
				if(!AddUnit(ref dt, op4, op5, 1)) throw new Exception(string.Format("Unit invalid in {0}", expr));
			break;
			case "min": case "-":
				if(!AddUnit(ref dt, op4, op5, -1)) throw new Exception(string.Format("Unit invalid in {0}", expr));
			break;
		}
		return result;
	}
	private bool AddUnit(ref DateTime dt, string n, string unit, int sign)
	{
		double amount = sign * double.Parse(n, System.Globalization.NumberStyles.Any, CultureInfo.InvariantCulture);
		switch(unit)
		{
			case "week": case "weeks": 
				dt = dt.AddDays(amount * 7);
			break;
			case "month": case "months":
				if(n.Contains(".")) throw new Exception(string.Format("Fractions in {0} are not supported for month units", n));
				dt = dt.AddMonths( (int)amount);
			break;
			case "year": case "years":
				if(n.Contains(".")) throw new Exception(string.Format("Fractions in {0} are not supported for year units", n));
				dt = dt.AddYears( (int)amount);
			break;
			case "": case "days": case "day":
				dt = dt.AddDays(amount);
			break;
			default: return false;
		}
		return true;
	}
	private DateTime ThisDate(string expr,  DateTime refdate, string elname)
	{
		DateTime dt = refdate;
		bool isstart = elname.IndexOf("start", StringComparison.OrdinalIgnoreCase) >=0;
		switch(expr)
		{
			case "year": dt = isstart ? new DateTime(refdate.Year, 01, 01) : new DateTime(refdate.Year, 12, 31); 
			break;
			case "month":
				{
					DateTime som = new DateTime(refdate.Year, refdate.Month , 01);
					dt = isstart ? som : new DateTime(refdate.Year, refdate.Month, som.AddMonths(1).AddDays(-1).Day); 
				}
			break;
			case "week":
				{
					int diff = (7 + (refdate.DayOfWeek - m_first_day_of_week)) % 7;
					dt = refdate.AddDays(-1 * diff).Date;
					dt = isstart ? dt : dt.AddDays(6);
				}
			break;
			case "day":
				dt = refdate;
			break;
		}
		return dt;
	}
