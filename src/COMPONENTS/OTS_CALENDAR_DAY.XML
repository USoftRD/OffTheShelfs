		<PROGRAM_SOURCE><![CDATA[using System;
using System.Globalization;
using System.Xml;
using System.Xml.Linq;
using System.Xml.XPath; 
using System.Text.RegularExpressions;

class OTS_CALENDAR_DAY
{
	private DayOfWeek	m_first_day_of_week;
	private DayOfWeek	m_last_day_of_week;
	private string		m_month_name_fmt;
	private string		m_day_name_fmt;
	private string		m_period_default_start_str;
	private string		m_period_default_end_str;
	private string		m_period_start_str;
	private string		m_period_end_str;
	private DateTime	m_period_start;
	private DateTime	m_period_end;
	private DateTime	m_dt_iterate;
	private double		m_days_step = 1.0;
	private string		m_cult_str;
	private string		m_default_cult_str;
	private CultureInfo	m_default_cult = CultureInfo.CurrentCulture;
	private CultureInfo	m_cult = CultureInfo.CurrentCulture;
	private readonly string[] m_formats= {
		"dd MMMM yyyy", "dd MMM yyyy", "d MMMM yyyy", "d MMM yyyy", "d M yyyy", "d M yy",
		"dd-MMMM-yyyy", "dd-MM-yyyy", "dd-MMM-yyyy", "dd-MMM-yy", 
		"d-MMMM-yyyy", "d-M-yyyy", "d-MMM-yyyy", "d-MMM-yy",
		"dd MM yyyy HH:mm:ss", "dd MMM yyyy HH:mm:ss", "dd MMM yyyy H:mm:ss", "dd MMMM yyyy HH:mm:ss", "dd MMMM yyyy H:mm:ss",
		"dd MM yyyy HH:mm:ssZ", "dd MMM yyyy HH:mm:ssZ", "dd MMM yyyy H:mm:ssZ", "dd MMMM yyyy HH:mm:ssZ", "dd MMMM yyyy H:mm:ssZ",
		"dd-MM-yyyy HH:mm:ss", "dd-MM-yyyy H:mm:ss", "dd-MMM-yy HH:mm:ss", "dd-MMM-yy H:mm:ss",
		"dd-MM-yyyy HH:mm:ssZ", "dd-MM-yyyy H:mm:ssZ", "dd-MMM-yy HH:mm:ssZ", "dd-MMM-yy H:mm:ssZ",
		"d M yyyy HH:mm:ss", "d M H:mm:ss", "d MMM yyyy HH:mm:ss", "d MMM yyyy H:mm:ss",
		"d M yyyy HH:mm:ssZ", "d M H:mm:ssZ", "d MMM yyyy HH:mm:ssZ", "d MMM yyyy H:mm:ssZ",
		"d-MMMM-yyyy HH:mm:ss", "d-MMMM-yyyy H:mm:ss", "d-M-yyyy HH:mm:ss", "d-M-yyyy H:mm:ss", "d-MMM-yy HH:mm:ss", "d-MMM-yy H:mm:ss",
		"d-MMMM-yyyy HH:mm:ssZ", "d-MMMM-yyyy H:mm:ssZ", "d-M-yyyy HH:mm:ssZ", "d-M-yyyy H:mm:ssZ", "d-MMM-yy HH:mm:ssZ", "d-MMM-yy H:mm:ssZ",
		"d-MMMM-yyyy HH:mm", "d-MMMM-yyyy H:mm", "d-M-yyyy HH:mm", "d-M-yyyy H:mm", "d-MMM-yy HH:mm", "d-MMM-yy H:mm",
		"dd-MM-yyyy HH:mm", "dd-MM-yyyy H:mm", "dd-MMM-yy HH:mm", "dd-MMM-yy H:mm",
		"d-MMMM-yyyy HHmm", "d-MMMM-yyyy Hmm", "d-M-yyyy HHmm", "d-M-yyyy Hmm", "d-MMM-yy HHmm", "d-MMM-yy Hmm",
		"dd-MM-yyyy HHmm", "dd-MM-yyyy Hmm", "dd-MMM-yy HHmm", "dd-MMM-yy Hmm",
		@"yyyy\/MMddHHmmss", // con date format
		@"yyyy\/MMdd", // con date short format without time
		"M/d/yyyy h:mm:ss tt", "M/d/yyyy h:mm tt", 
		"MM/dd/yyyy hh:mm:ss", "M/d/yyyy h:mm:ss", 
		"M/d/yyyy hh:mm tt", "M/d/yyyy hh tt", 
		"M/d/yyyy h:mm", "M/d/yyyy h:mm", 
		"MM/dd/yyyy hh:mm", "M/dd/yyyy hh:mm",
		"MM/d/yyyy HH:mm:ss.ffffff",
		"yyyy-MM-dd'T'HH:mm:ss.fffffff'Z'",
		"yyyy-MM-dd'T'HH:mm:ss",
		"M/d/yyyy",
