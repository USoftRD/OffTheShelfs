		<PROGRAM_SOURCE><![CDATA[using System;
using System.Security.Cryptography;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using System.Security.Cryptography.Xml;
using System.Xml;
using System.IO;
using System.Net;
using System.Xml.Xsl;
using System.Xml.XPath;

class OTS_XML_SIGNING
{
	public OTS_XML_SIGNING()
	{
		const string x = "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256";
		CryptoConfig.AddAlgorithm(typeof (RSAPKCS1SHA512SignatureDescription), x);
	}
	public  string AddSignature(string xmlDoc, string subjectName, string result)
    {
        if (string.IsNullOrEmpty(xmlDoc))
		{
			throw new ArgumentNullException("xmlDoc argument is empty");
		}
        if (string.IsNullOrEmpty(subjectName)) 
		{
			throw new ArgumentNullException("No Certificate subjectName was specified");
		}
        X509Certificate2 cert = GetCertificateBySubject(subjectName);
        XmlDocument doc = new XmlDocument();
        doc.PreserveWhitespace = false;
		if(xmlDoc.StartsWith("<"))
		{
			doc.LoadXml(xmlDoc);
		}
		else
		{
			doc.Load(xmlDoc);
		}
        SignedXml signedXml = new SignedXml(doc);
        signedXml.SigningKey = cert.PrivateKey;
        Reference reference = new Reference();
        reference.Uri = "";
        XmlDsigEnvelopedSignatureTransform env = new XmlDsigEnvelopedSignatureTransform();
        reference.AddTransform(env);
        signedXml.AddReference(reference);
        KeyInfo keyInfo = new KeyInfo();
        keyInfo.AddClause(new KeyInfoX509Data(cert));
        signedXml.KeyInfo = keyInfo;
        signedXml.ComputeSignature();
        XmlElement xmlDigitalSignature = signedXml.GetXml();
        doc.DocumentElement.AppendChild(doc.ImportNode(xmlDigitalSignature, true));
        if (doc.FirstChild is XmlDeclaration)
        {
            doc.RemoveChild(doc.FirstChild);
        }
		if(!string.IsNullOrEmpty(result))
		{
			using (XmlTextWriter xmltw = new XmlTextWriter(result, new UTF8Encoding(false)))
			{
				if(!string.IsNullOrEmpty(result))
				{
					doc.WriteTo(xmltw);
				}
				xmltw.Close();
			}
			return result;
		}
		else
		{
			using (TextWriter writer = new Utf8StringWriter())
			{
				using (XmlWriter xmltw = XmlWriter.Create(writer))
				{
					doc.WriteTo(xmltw);
				}
				return writer.ToString(); 
			}
		}
    }
	public string RemoveSignature(string xmlDoc, string certificateSubject, string filePath)
	{
		if (string.IsNullOrEmpty(xmlDoc)) 
		{
			throw new ArgumentNullException("xmlDocument argument is empty");
		}
        if (string.IsNullOrEmpty(certificateSubject)) 
		{
			throw new ArgumentNullException("No Certificate Subject was specified");
		}
        X509Certificate2 cert = GetCertificateBySubject(certificateSubject);
        XmlDocument xmlDocument = new XmlDocument();
		if(xmlDoc.StartsWith("<"))
		{
			xmlDocument.LoadXml(xmlDoc);
		}
		else
		{
			xmlDocument.Load(xmlDoc);
		}
		if(!VerifySignatureOfDocument(xmlDocument, cert))
		{
			throw new Exception("Verification of the signature failed");
		}
        XmlNodeList nodeList = xmlDocument.GetElementsByTagName("Signature", "*");
		for (int i = 0; i < nodeList.Count; i++)  
		{
			nodeList[i].ParentNode.RemoveChild(nodeList[i]);
		}
		if(string.IsNullOrEmpty(filePath))
		{	
			return xmlDocument.InnerXml;
		}
		xmlDocument.Save(filePath);
		return filePath;
	}

    // Verify the signature of an XML file against an asymetric  algorithm and return the result.
    public Boolean VerifySignature(string xmlDoc, string certificateSubject)
    {
        if (string.IsNullOrEmpty(xmlDoc)) throw new ArgumentNullException("xmlDoc");
        if (string.IsNullOrEmpty(certificateSubject)) throw new ArgumentNullException("certificateSubject");
        X509Certificate2 cert = GetCertificateBySubject(certificateSubject);
        XmlDocument xmlDocument = new XmlDocument();
		if(xmlDoc.StartsWith("<"))
		{
			xmlDocument.LoadXml(xmlDoc);
		}
		else
		{
			xmlDocument.Load(xmlDoc);
		}
		return VerifySignatureOfDocument(xmlDocument, cert);
    }
	private Boolean VerifySignatureOfDocument(XmlDocument xmlDocument, X509Certificate2 cert)
	{
        SignedXml signedXml = new SignedXml(xmlDocument);
        XmlNodeList nodeList = xmlDocument.GetElementsByTagName("Signature", "*");
        signedXml.LoadXml((XmlElement)nodeList[0]);
        return signedXml.CheckSignature(cert, true);		
	}
	public Boolean VerifySignatureWithKey(string xmlDoc, string mimeKey)
	{
		byte[] binaryCertData = Convert.FromBase64String(mimeKey);
		X509Certificate2 cert = new X509Certificate2(binaryCertData);
		Console.WriteLine(cert.PublicKey.Key.ToXmlString(false));
		return _VerifySignatureWithKey(xmlDoc, cert/*cert.PublicKey.Key*/);
	}
    private Boolean _VerifySignatureWithKey(string xmlDoc, X509Certificate2 cert /*RSA key*/)
    {
        if (string.IsNullOrEmpty(xmlDoc)) throw new ArgumentNullException("xmlDoc");
        XmlDocument xmlDocument = new XmlDocument();
		if(xmlDoc.StartsWith("<"))
		{
			xmlDocument.LoadXml(xmlDoc);
		}
		else
		{
			xmlDocument.Load(xmlDoc);
		}
        SignedXml signedXml = new SignedXml(xmlDocument);
        XmlNodeList nodeList = xmlDocument.GetElementsByTagName("Signature", "*");
        signedXml.LoadXml((XmlElement)nodeList[0]);
        return signedXml.CheckSignature(cert, true);
    }

    private static X509Certificate2 GetCertificateBySubject(string certificateSubject)
    {
        if (string.IsNullOrEmpty(certificateSubject))
		{
			throw new ArgumentNullException("certificateSubject");
		}
        // Load the certificate from the certificate store.
        X509Certificate2 cert = null;
        X509Store store = new X509Store("My", StoreLocation.CurrentUser);

        try
        {
            store.Open(OpenFlags.ReadOnly | OpenFlags.OpenExistingOnly);
            X509Certificate2Collection certCol = store.Certificates;
            // Find the certificate with the specified subject.
            foreach (X509Certificate2 c in certCol)
            {
				Console.WriteLine(c.Subject);
                if (c.Subject.Contains(certificateSubject))
                {
                    cert = c;
                    break;
                }
            }
            if (cert == null)
            {
                throw new CryptographicException("The certificate could not be found.");
            }
        }
        finally
        {
            store.Close();
        }
        return cert;
    }

	public static string SigningCertFromFederationMetaData(string url)
	{
		WebClient wc = new WebClient();
		string xml = wc.DownloadString(url);
		if(!string.IsNullOrEmpty(xml))
		{
			return eval(xml,
				"/_:EntityDescriptor/_:IDPSSODescriptor/_:KeyDescriptor[@use='signing']/xmldsig:KeyInfo/xmldsig:X509Data/*",
			new Object[2] { "xmldsig", "http://www.w3.org/2000/09/xmldsig#" });
		}
		return "failed";
	}
	public static string eval(string xmlDoc, string xpath, Object[] namespaceAliasPairs)
	{
		StringBuilder result = new StringBuilder();
		XmlDocument doc = new XmlDocument();
        if (xmlDoc.StartsWith("<"))
        {
            doc.LoadXml(xmlDoc);
        }
        else
        {
            doc.Load(xmlDoc);
        }
		XmlNamespaceManager nsm = new XmlNamespaceManager(doc.NameTable);
		XmlNodeList nsList = doc.SelectNodes(@"//namespace::*[not(. = ../../namespace::*)]");
		foreach(XmlNode nsNode in nsList)
		{
			if(nsNode.LocalName.Equals("xmlns"))
			{
				continue;
			}
			nsm.AddNamespace(nsNode.LocalName,nsNode.Value);
		}
		nsm.AddNamespace("_", doc.DocumentElement.NamespaceURI);
		for(int i=0; namespaceAliasPairs!=null && i < namespaceAliasPairs.Length - 1; i+=2)
		{
			nsm.AddNamespace((string)namespaceAliasPairs[i], (string)namespaceAliasPairs[i+1]);
		}
        XPathNavigator pn = doc.CreateNavigator();
        pn.MoveToRoot();
        pn.MoveToFirstChild();
        XPathNodeIterator ni = pn.Select(xpath, nsm);
		while(ni.MoveNext())
		{
			result.Append(ni.Current.InnerXml);
		}
		return result.ToString();
	}

	private class Utf8StringWriter : StringWriter
	{
		public override Encoding Encoding
		{
			 get { return Encoding.UTF8; }
		}
	}
}


public sealed class RSAPKCS1SHA512SignatureDescription : SignatureDescription
{
    public RSAPKCS1SHA512SignatureDescription()
    {
		KeyAlgorithm = "System.Security.Cryptography.RSACryptoServiceProvider";
		DigestAlgorithm = "System.Security.Cryptography.SHA256Managed";
		FormatterAlgorithm = "System.Security.Cryptography.RSAPKCS1SignatureFormatter";
		DeformatterAlgorithm = "System.Security.Cryptography.RSAPKCS1SignatureDeformatter";
    }

    public override AsymmetricSignatureDeformatter CreateDeformatter(AsymmetricAlgorithm key)
    {
        if( key == null )
		{
			throw new ArgumentNullException("AsymmetricAlgorithm key is not defined");
		}
		var asymmetricSignatureDeformatter = (AsymmetricSignatureDeformatter)CryptoConfig.CreateFromName(DeformatterAlgorithm);
		asymmetricSignatureDeformatter.SetKey(key);
		asymmetricSignatureDeformatter.SetHashAlgorithm("SHA256");
		return asymmetricSignatureDeformatter;
    }

    public override AsymmetricSignatureFormatter CreateFormatter( AsymmetricAlgorithm key )
    {
        if( key == null )
		{
			throw new ArgumentNullException( "AsymmetricAlgorithm key is not defined" );
		}
		var asymmetricSignatureFormatter = (AsymmetricSignatureFormatter)CryptoConfig.CreateFromName(FormatterAlgorithm);
		asymmetricSignatureFormatter.SetKey(key);
		asymmetricSignatureFormatter.SetHashAlgorithm("SHA256");
		return asymmetricSignatureFormatter;		
    }
}]]></PROGRAM_SOURCE>
