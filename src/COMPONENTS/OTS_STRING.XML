		<PROGRAM_SOURCE><![CDATA[using System;
using System.Text;

class OTS_STRING: USoft.Text.WStrings
{
	private string	m_s;
	StringBuilder	m_concat_result = null;

	public void SetString(string s)
	{
		m_s = s;
	}

	public void AppendString(string s)
	{
		m_s += s;
	}

	public void PrependString(string s)
	{
		m_s = s + m_s;
	}

	public string GetString()
	{
		return m_s;
	}

	public static string InsertBeforeLast(string source, string insert, string find)
	{
		int pos = source.LastIndexOf(find);
		return pos == -1 ? source + insert : source.Insert(pos, insert);
	}

	public static bool Equal(string a, string b)
	{
		return a == b ? true : false;
	}

	public static int IndexOf(string source, string pattern)
	{
		return source.IndexOf( pattern );
	}

	public static int IndexOfWithStart(string source, string pattern, int start_pos)
	{
		return source.IndexOf( pattern, start_pos );
	}

	public static bool EndsWith( string source, string pattern )
	{
		if ( String.IsNullOrEmpty( source ) )
			throw new System.ArgumentException("Parameter cannot be null", "source" );

		if ( String.IsNullOrEmpty( pattern ) )
			throw new System.ArgumentException("Parameter cannot be null", "pattern" );

		return source.EndsWith( pattern );
	}

	public int RecordConcatAggr(string field_sep, string record_sep, Object[] fields)
	{
		if(fields ==null) return 0;
		if(m_concat_result == null) 
		{
			m_concat_result = new StringBuilder();
		}
		else
		{
			m_concat_result.Append(record_sep);
		}
		for(int i=0; i<fields.Length; i++)
		{
			if(i>0) m_concat_result.Append(field_sep);
			m_concat_result.Append( (string)fields[i] );
		}
		return 1;
	}

	public int RecordConcatResult(out string result)
	{
		result = m_concat_result.ToString();
		m_concat_result = null;
		return 1;
	}
}]]></PROGRAM_SOURCE>
