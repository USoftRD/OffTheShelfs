		<PROGRAM_SOURCE><![CDATA[using System;
using System.IO;
using System.Text;
using System.Linq;
using System.Xml;
using System.Threading;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Text;
using SyslogNet.Client;
using SyslogNet.Client.Serialization;
using SyslogNet.Client.Transport;

class OTS_SYSLOG_CLIENT_RFC3164 {

	string SYSLOG_SERVER = "localhost";
	int SYSLOG_PORT   = 514;
	bool SYSLOG_TCP = false;

	public OTS_SYSLOG_CLIENT_RFC3164(string host, int p, bool tcp)
	{
		if(host!=null){
			SYSLOG_SERVER = host;
		}
		if(p!=null){
			SYSLOG_PORT = p;
		}
		if(tcp!=null){
			SYSLOG_TCP = tcp;
		}
			
	}


	public void SendLog(string AUDIT_TYPE, string SIDU, string LOGGING) {
		XmlDocument result = new XmlDocument();
		result.LoadXml(LOGGING);
		string tableName = result.GetElementsByTagName("*").Item(0).Name;
		//File.AppendAllText(@"c:\temp\Audit.log", SIDU+":"+tableName + Environment.NewLine);

		string logMessage =  "";
		logMessage += tableName+"["+SIDU+"]: ";							//log line tag: "<tableName>[<SIDU>]:"
		logMessage += LOGGING.Replace("\r\n", " ").Replace("\t", " ");		//remove all new-lines and tabs from the log message (so that only one line is submitted)

		string hostName = System.Environment.GetEnvironmentVariable("COMPUTERNAME");

		SyslogMessage sMessage = new SyslogMessage(DateTimeOffset.Now, Facility.LogAudit, Severity.Info, hostName, "", logMessage+Environment.NewLine);

		try {
			ISyslogMessageSender client = null;

			if(SYSLOG_TCP){
				client = new SyslogTcpSender(SYSLOG_SERVER, SYSLOG_PORT);
			}else{
				client = new SyslogUdpSender(SYSLOG_SERVER, SYSLOG_PORT);
			}
			ISyslogMessageSerializer serializer = new SyslogRfc3164MessageSerializer ();

			client.Send(sMessage, serializer);
			//File.AppendAllText(@"c:\temp\Audit.log",  "sent"+ Environment.NewLine);	
		}
			catch (Exception ex)
			{
				//File.AppendAllText(@"c:\temp\Audit.log",  "ERROR: " + ex + Environment.NewLine);
				Console.WriteLine("ERROR: " + ex);
			}
		//File.AppendAllText(@"c:\temp\Audit.log",  logMessage+ Environment.NewLine);
	}
}

