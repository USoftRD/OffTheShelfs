		<ASSEMBLYREFS><![CDATA[]]></ASSEMBLYREFS>
		<PROGRAM_SOURCE><![CDATA[<?xml version="1.0" encoding="UTF-8" ?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:strings="USoft:Strings" xmlns:xslutil="USoft:XslUtil">
	<xsl:output method="text" version="1.0" indent="yes"/>

	<xsl:param name="table_name"/>
	<xsl:param name="old_values"/>
	<xsl:param name="new_values"/>
	<xsl:variable name="apos">'</xsl:variable>
	<xsl:variable name="sql">
		<![CDATA[
			select 
				(
					invoke EXECUTE_DEFAULT_VALUE_SELECTS.apply with
					invoke xml.sqlexport with select 
						TABLE_NAME
					,	COLUMN_NAME  
					,	(
							invoke substitute_row.apply with
							select 
								(
									INVOKE  XML.JSON2XML WITH
									SELECT  :new_values
									,      	'FULL'
								)
							, 	'selectStatement'
							, 	(
									invoke substitute_row.apply with
									select 
										(
											INVOKE  XML.JSON2XML WITH
											SELECT  :old_values
											,      	'FULL'
										)
									, 'selectStatement'
									, DEFAULT_VALUE_SQL
									, 'namePrefix'
									, 'OLD_'
								)
						) "DEFAULT_VALUE_SQL"
					from column_default_value
					where table_name = :table_name
				)	"RESULT"
		]]]]><![CDATA[>
	</xsl:variable>
	<xsl:variable name="sqlTableNameReplaced" select="strings:Replace($sql, ':table_name', concat($apos, $table_name, $apos))"/>
	<xsl:variable name="sqlOldValuesReplaced" select="strings:Replace($sqlTableNameReplaced, ':old_values', concat($apos, $old_values, $apos))"/>
	<xsl:variable name="sqlNewValuesReplaced" select="strings:Replace($sqlOldValuesReplaced, ':new_values', concat($apos, $new_values, $apos))"/>
	<xsl:variable name="result" select="document(concat('invoke xml.sqlexport with ', $sqlNewValuesReplaced))/SQLXMLExport/Rows/Row[1]/Field[@alias='RESULT']"/>

	<xsl:template match="/">
		<xsl:value-of select="$result"/>
	</xsl:template>
</xsl:stylesheet>]]></PROGRAM_SOURCE>
