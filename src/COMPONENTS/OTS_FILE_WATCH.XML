		<ASSEMBLYREFS><![CDATA[System.Xml.dll]]></ASSEMBLYREFS>
		<PROGRAM_SOURCE><![CDATA[using System;
using System.IO;
using System.Text;
using System.Collections.Generic;
using System.Data;

public class OTS_FILE_WATCH 
{
	private DataTable m_table = new DataTable();
	private static FileSystemWatcher m_watcher = null;
	private int m_seqno = 0;
	private readonly object m_sync = new object();
	private int m_row_number = 0;

	public OTS_FILE_WATCH()
	{
		m_table.Columns.Add("seqno", typeof(int));
		m_table.Columns.Add("path", typeof(string));
		m_table.Columns.Add("changetype", typeof(string));
		m_table.Columns.Add("oldname", typeof(string));
	}
	public void Start(string path, string filterpath) 
	{
		if(m_watcher!=null)
		{
			m_watcher.Dispose();
		}
		m_table.Clear();
		m_seqno = 0;
		m_watcher = new FileSystemWatcher();
		m_watcher.Path = Path.GetDirectoryName(path);
		if(!string.IsNullOrEmpty(filterpath))
		{
			m_watcher.Filter = Path.GetFileName(filterpath);
		}
		m_watcher.NotifyFilter = NotifyFilters.LastWrite | NotifyFilters.FileName | NotifyFilters.Size;
		//  NotifyFilters.LastAccess  NotifyFilters.DirectoryName
		// m_watcher.Filter = "*.txt";
		m_watcher.Deleted += new System.IO.FileSystemEventHandler(OnDelete);
		m_watcher.Renamed += new System.IO.RenamedEventHandler(OnRenamed);
		m_watcher.Changed += new System.IO.FileSystemEventHandler(OnChanged);
		m_watcher.Created += new System.IO.FileSystemEventHandler(OnCreate);
		m_watcher.EnableRaisingEvents = true;
	}
	private void OnChanged(object source, FileSystemEventArgs e)
	{
		lock (m_sync)
		{
			DataRow dr = m_table.NewRow();
			dr[0] = m_seqno++;
			dr[1] = e.FullPath;
			dr[2] = e.ChangeType.ToString();
			m_table.Rows.Add(dr);
			m_table.AcceptChanges();
		}
	}
	private void OnRenamed(object source, RenamedEventArgs e)
	{
		lock (m_sync)
		{
			DataRow dr = m_table.NewRow();
			dr[0] = m_seqno++;
			dr[1] = e.FullPath;
			dr[2] = e.ChangeType.ToString();
			dr[3] = e.OldName;
			m_table.Rows.Add(dr);
			m_table.AcceptChanges();
		}
	}
	private void OnDelete(object source, FileSystemEventArgs e)
	{
		lock (m_sync)
		{
			DataRow dr = m_table.NewRow();
			dr[0] = m_seqno++;
			dr[1] = e.FullPath;
			dr[2] = e.ChangeType.ToString();
			dr[3] = string.Empty;
			m_table.Rows.Add(dr);
			m_table.AcceptChanges();
		}
	}
	private void OnCreate(object source, FileSystemEventArgs e)
	{
		lock (m_sync)
		{
			DataRow dr = m_table.NewRow();
			dr[0] = m_seqno++;
			dr[1] = e.FullPath;
			dr[2] = e.ChangeType.ToString();
			dr[3] = string.Empty;
			m_table.Rows.Add(dr);
			m_table.AcceptChanges();
		}
	}
	public int QueryExe(string conditions)
	{
        m_row_number = 0;
		return 1;
	}
	public int QueryFetch(out int seqno, out string fullpath, out string changetype, out string oldpath)
	{
		seqno = -1;
		fullpath = changetype = oldpath = string.Empty;
		DataRow row = null;
		if(m_row_number >= m_table.Rows.Count)
		{
			return 0;
		}
		lock (m_sync)
		{
			row = m_table.Rows[m_row_number++];
			if (row == null)
			{
				return 0;
			}
			seqno =(int)row[m_table.Columns[0]];
			fullpath =(string)row[m_table.Columns[1]];
			changetype = (row[m_table.Columns[2]].GetType() == typeof(string)) ? (string)row[m_table.Columns[2]] : string.Empty;
			oldpath = (row[m_table.Columns[3]].GetType() == typeof(string)) ? (string)row[m_table.Columns[3]] : string.Empty;
		}
		return 1;
	}
}]]></PROGRAM_SOURCE>
