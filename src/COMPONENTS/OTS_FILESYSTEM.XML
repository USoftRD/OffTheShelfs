		<PROGRAM_SOURCE><![CDATA[using System;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;

class OTS_FILESYSTEM 
{
	public static string PathCombine(Object[] args)
	{
		string[] strargs = new string[args.Length];
		for(int i=0; i<args.Length; i++)
		{
			strargs[i] = (string)args[i];
		}
		return Path.Combine(strargs);
	}
	public static String DirectoryName(String filepath)
	{
		FileInfo fi = new FileInfo(filepath);
		return fi.DirectoryName;
	}
	public static String FileName(String filepath)
	{
		FileInfo fi = new FileInfo(filepath);
		return fi.Name;
	}
	public static String FileExtension(String filepath)
	{
		FileInfo fi = new FileInfo(filepath);
		return fi.Extension;
	}
	public static String ReadTextFile(String filename)
	{
		try
		{
			return File.ReadAllText(filename);
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("ReadTextFile fails: {0}",  ex.ToString()));
		}
	}
	public static String ReadBinaryFileToBase64(String filename)
	{
		byte[] bytes = File.ReadAllBytes(filename);
		return Convert.ToBase64String(bytes);
	}
	public static DateTime AccessTime(string filename)
	{
		return File.GetLastAccessTime(filename);
	}           
	public static DateTime Modified(string filename)
	{
		return File.GetLastWriteTime(filename);
	} 
	// returns the argument number of the newest file, starting at 0 for the first argument
	public static int NewestFile(Object[] files)
	{	
		int newestpos = -1;
		DateTime newest = new DateTime(1970,1,1,0,0,0);
		for(int i = 0; i < files.Length; i++)
		{
			string filepath = files[i].ToString();
			if(File.Exists(filepath))
			{
				DateTime dt = File.GetLastWriteTime(filepath);
				if(dt >= newest)
				{
					newest = dt;
					newestpos = i;
				}
			}
		}
		return newestpos;
	} 
	public static bool WriteAllText(string filename, Object[] textargs)
	{
		if(textargs==null || textargs.Length < 1) return false;
		try
		{
			using (TextWriter tw = new StreamWriter(filename))
			{
				foreach(object textobj in textargs)
				{
					tw.Write((string)textobj);
				}
			}
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("WriteAllText fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool WriteAllTextLines(string filename, Object[] textargs)
	{
		if(textargs==null || textargs.Length < 1) return false;
		try
		{
			using (TextWriter tw = new StreamWriter(filename))
			{
				foreach(object textobj in textargs)
				{
					tw.WriteLine((string)textobj);
				}
			}
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("WriteAllText fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool AppendAllText(string filename, Object[] textargs)
	{
		if(textargs==null || textargs.Length < 1) return false;
		try
		{
			using (TextWriter tw = File.AppendText(filename))
			{
				foreach(object textobj in textargs)
				{
					tw.Write((string)textobj);
				}
			}
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("AppendAllText fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool AppendAllTextLines(string filename, Object[] textargs)
	{
		if(textargs==null || textargs.Length < 1) return false;
		try
		{
			using (TextWriter tw = File.AppendText(filename))
			{
				foreach(object textobj in textargs)
				{
					tw.WriteLine((string)textobj);
				}
			}
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("AppendAllText fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool FileCopy(string sourceFile, string destFile)
	{
		try
		{
			File.Copy( sourceFile, destFile, true);
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("FileCopy fails: {0}", ex.ToString()));
		}
		return false;
	}
   	public static void DirectoryCopy(string s, string d)
	{
		DirectoryInfo ds = new DirectoryInfo(s);
		DirectoryInfo dd = new DirectoryInfo(d);
		CopyAll(ds, dd);
	}
	private static void CopyAll(DirectoryInfo source, DirectoryInfo target)
    {
		Directory.CreateDirectory(target.FullName);
		foreach (FileInfo fi in source.GetFiles())
		{//Console.WriteLine(@"Copying {0}\{1}", target.FullName, fi.Name);
			fi.CopyTo(Path.Combine(target.FullName, fi.Name), true);
		}
        foreach (DirectoryInfo diSourceSubDir in source.GetDirectories())
		{
			DirectoryInfo nextTargetSubDir = target.CreateSubdirectory(diSourceSubDir.Name);
			CopyAll(diSourceSubDir, nextTargetSubDir);
		}
    }
	public static bool FileMove(string filename1, string filename2)
	{
		try
		{
			File.Move( filename1, filename2);
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("FileMove fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool FileExists(string path)
	{
		return File.Exists(path);
	}
	public static bool DirectoryExists(string path)
	{
		return Directory.Exists(path);
	}
	public static bool DirectoryIsEmptyOrNotExists(string path)
	{
		return !Directory.Exists(path) || DirectoryIsEmpty(path);
	}
	public static bool DirectoryIsEmpty(string path)
	{
		try
		{
			int nfiles = Directory.GetFiles(path).Length;
			if(nfiles > 0)
				return false;
			int ndirs = Directory.GetDirectories(path).Length;
			if(ndirs>0)
				return false;
		}
		catch(Exception ex)
		{
			throw new Exception("IsEmpty check for " + path + " fails: " + ex.Message); //decide whether to report errors or just return false
		}
		return true;
	}
	public static bool DirectoryMove(string filename1, string filename2)
	{
		try
		{
			Directory.Move( filename1, filename2);
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("DirectoryMove fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool FileDelete(string filepath)
	{
		try
		{
			File.Delete(filepath);
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("FileDelete fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool FilesDelete(string pathpattern)
	{
		int dir_end = pathpattern.LastIndexOf(@"\");
		string dirpattern = (dir_end < 1) ? string.Empty : pathpattern.Substring(0, dir_end);
		string filepattern = (dir_end < 1) ? pathpattern : pathpattern.Substring(dir_end + 1);
		try
		{
			string dirpath = new FileInfo(dirpattern).FullName;
			DirectoryInfo dir = new DirectoryInfo(dirpath);
			foreach (FileInfo file in dir.EnumerateFiles(filepattern))
			{
				file.Delete();
			}
			return true;
		}
		catch (Exception ex)
		{
			throw new Exception(string.Format("FilesDelete fails: {0}", ex.ToString()));
		}
		return false;
	}

	public static bool DirectoryDelete(string dirname)
	{
		if(!Directory.Exists(dirname))
		{
			return false;
		}
		try
		{
			Directory.Delete( dirname);
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("DirectoryDelete fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool DirectoryDeleteRecursive(string dirname)
	{
		if(!Directory.Exists(dirname))
		{
			return false;
		}
		try
		{
			Directory.Delete(dirname, true);
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("DirectoryDeleteRecursive fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool DirectoryCreate(string dirname)
	{
		try
		{
			Directory.CreateDirectory( dirname);
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("DirectoryCreate fails: {0}", ex.ToString()));
		}
		return false;
	}
	public static bool  ConcatFiles(string srcfilename1, string srcfilename2, string destfilename)
	{
		try
		{
			File.Copy(srcfilename1, destfilename);
			TextWriter tw = File.AppendText(destfilename);
			StreamReader sr;
			sr=File.OpenText(srcfilename2);
			string str=sr.ReadLine();
			while(str!=null)
			{
				tw.WriteLine(str);
				str=sr.ReadLine();
			}
			tw.Close();
			sr.Close();
			return true;
		}
		catch(Exception ex)
		{
			throw new Exception(string.Format("ConcatFiles fails: {0}", ex.ToString()));
		}
		return false;
	}
	[DllImport("kernel32.dll", CharSet = CharSet.Auto)]
	private static extern int GetShortPathName
	(
		[MarshalAs(UnmanagedType.LPTStr)]
		 string path,
		 [MarshalAs(UnmanagedType.LPTStr)]
		  StringBuilder shortPath,
		  int shortPathLength
	);

	public static string GetShortPathName(String longpath)
	{
		StringBuilder shortPath = new StringBuilder(255);
		GetShortPathName(longpath, shortPath, shortPath.Capacity);
		return shortPath.ToString();
	}
}]]></PROGRAM_SOURCE>
