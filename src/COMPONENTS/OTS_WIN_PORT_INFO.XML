		<ASSEMBLYREFS><![CDATA[]]></ASSEMBLYREFS>
		<PROGRAM_SOURCE><![CDATA[using System;
using USoft.Net.Util; 
using System.Xml.XPath;

class OTS_WIN_PORT_INFO
{
	XPathNodeIterator m_nodes;

	public int FreePort()
	{
		return USoft.Net.WNetwork.FreePort();
	}
	public bool IsFreePort(int p)
	{
		return PortInfo.IsFreePort(p);
	}
	public string Portinfo()
	{
		XPathNodeIterator n =  PortInfo.ports();
		if(n.MoveNext())
		{
			return n.Current.InnerXml;
		}
		return string.Empty;
	}
	public string PortDetails(int p)
	{
		XPathNodeIterator n =  PortInfo.portinfo(p);
		if(n.MoveNext())
		{
			return n.Current.InnerXml;
		}
		return string.Empty;
	}
	public int QueryExe(string dummy)
	{
		XPathNodeIterator n =  PortInfo.ports();
		if(!n.MoveNext()) return 0;
		m_nodes = n.Current.Select("//TcpPort|//UdpPort");
		return 1;
	}
	public int QueryFetch(out string localPort, out string remotePort, out string portType, out string state, out string localAddress, out string remoteAddress, out string processName, out string processId)
	{
		localPort = remotePort = portType = state = localAddress = remoteAddress = processName = processId = string.Empty;
		if(!m_nodes.MoveNext()) return 0;
		portType = m_nodes.Current.Name;
		localPort = m_nodes.Current.GetAttribute("LocalPort", string.Empty);
		remotePort = m_nodes.Current.GetAttribute("RemotePort", string.Empty);
		state = m_nodes.Current.GetAttribute("State", string.Empty);
		localAddress = m_nodes.Current.GetAttribute("LocalAddress", string.Empty);
		remoteAddress = m_nodes.Current.GetAttribute("RemoteAddress", string.Empty);
		processName = m_nodes.Current.GetAttribute("ProcessName", string.Empty);
		processId = m_nodes.Current.GetAttribute("ProcessId", string.Empty);
		return 1;
	}
}]]></PROGRAM_SOURCE>
