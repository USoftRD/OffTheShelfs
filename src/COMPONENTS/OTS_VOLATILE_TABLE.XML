		<ASSEMBLYREFS><![CDATA[System.Xml.dll]]></ASSEMBLYREFS>
		<PROGRAM_SOURCE><![CDATA[using System;
using System.Data;
using System.Xml;
using System.Xml.XPath;
using System.Collections.Generic;

public class OTS_VOLATILE_TABLE
{
	private readonly int m_max_fields = 10;

	private DataTable m_table = new DataTable();
	private string m_initial_data_xml = null;
    private int m_row_number = 0;

	public OTS_VOLATILE_TABLE(int? n_fields, string initial_data_xml)
	{
		int num_fields = (n_fields == null || n_fields.Value > m_max_fields) ? m_max_fields : n_fields.Value;
		for(int i=0; i<num_fields; i++)
		{
			m_table.Columns.Add(i.ToString(), typeof(string));
		}
		InsertXmlData(initial_data_xml);
		m_table.AcceptChanges();
		m_initial_data_xml = initial_data_xml;
	}
	private void InsertXmlData(string xml)
	{
		if(string.IsNullOrWhiteSpace(xml)) 
		{
			return;
		}
		xml = xml.Trim();
		XmlDocument xml_doc = new XmlDocument();
		if(xml.StartsWith("<"))
		{
			xml_doc.LoadXml(xml);
		}
		else
		{
			xml_doc.Load(xml);
		}
		XPathNodeIterator ni = xml_doc.CreateNavigator().Select("/*/*");
		while(ni.MoveNext())
		{
			XPathNavigator ni_clone = ni.Current.Clone();
			XPathNodeIterator attr = ni_clone.Select("@*");
			DataRow dr = m_table.NewRow();
			for(int i=0; i<m_table.Columns.Count; i++)
			{
				if(attr.MoveNext()) dr[i] = attr.Current.Value;
			}
			m_table.Rows.Add(dr);
		}
	}
	public void Reset()
	{
		m_table.Clear();
		InsertXmlData(m_initial_data_xml);
		m_table.AcceptChanges();
	}
	public void Clear()
	{
		m_table.Clear();
	}
	public void InsertRow(Object[] fields)
	{
		DataRow dr = m_table.NewRow();
		for(int i=0; i<m_table.Columns.Count; i++)
		{
			dr[i] = i < fields.Length ? (string)fields[i] : string.Empty;
		}
		m_table.Rows.Add(dr);
	}
	public void UpdateRow(Object[] fields)
	{
		for(int i = 0; i < m_table.Rows.Count; i++)
		{
			DataRow dr = m_table.Rows[i];
			if(dr.RowState == DataRowState.Deleted)
			{
				continue;
			}
			if (dr[0].Equals(fields[0]))
			{
				for(int j=1; j<m_table.Columns.Count; j++)
				{
					dr[j] = j < fields.Length ? (string)fields[j] : string.Empty;
				}
			}
		}
	}
	public void DeleteRow(string field1)
	{
		for(int i = 0; i < m_table.Rows.Count; i++)
		{
			DataRow dr = m_table.Rows[i];	
			if(dr.RowState == DataRowState.Deleted)
			{
				continue;
			}
			if (dr[0].Equals(field1))
			{
				dr.Delete();
			}
		}
	}
	public int QueryExe(Object[] fields)
	{
        m_row_number = 0;
		return 1;
	}
	public int QueryFetch(out string field1, out string field2, out string field3, out string field4, out string field5, out string field6, out string field7, out string field8, out string field9, out string field10)
	{
		field1 = field2 = field3 = field4 = field5 = field6 = field7 = field8 = field9 = field10 = string.Empty;
		DataRow row = null;
		for(int rn=m_row_number; rn < m_table.Rows.Count; rn++)
		{
			row = m_table.Rows[rn];
			if(row.RowState != DataRowState.Deleted)
			{
				m_row_number = rn + 1;
				break;
			}
			row = null;
		}
		if (row == null)
		{
			return 0;
		}
		field1 = m_table.Columns.Count > 0 ? (string)row[m_table.Columns[0]] : string.Empty;
		field2 = m_table.Columns.Count > 1 ? (string)row[m_table.Columns[1]] : string.Empty;
		field3 = m_table.Columns.Count > 2 ? (string)row[m_table.Columns[2]] : string.Empty;
		field4 = m_table.Columns.Count > 3 ? (string)row[m_table.Columns[3]] : string.Empty;
		field5 = m_table.Columns.Count > 4 ? (string)row[m_table.Columns[4]] : string.Empty;
		field6 = m_table.Columns.Count > 5 ? (string)row[m_table.Columns[5]] : string.Empty;
		field7 = m_table.Columns.Count > 6 ? (string)row[m_table.Columns[6]] : string.Empty;
		field8 = m_table.Columns.Count > 7 ? (string)row[m_table.Columns[7]] : string.Empty;
		field9 = m_table.Columns.Count > 8 ? (string)row[m_table.Columns[8]] : string.Empty;
		field10 = m_table.Columns.Count > 9 ? (string)row[m_table.Columns[9]] : string.Empty;
		return 1;
	}
	public void Commit()
	{
		m_table.AcceptChanges();
	}
	public void Rollback()
	{
		m_table.RejectChanges();
	}
}]]></PROGRAM_SOURCE>
