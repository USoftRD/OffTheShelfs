		<PROGRAM_SOURCE><![CDATA[using System;
using System.IO;

class OTS_CSV_UTIL 
{
	TextWriter	m_tw = null;
	string		m_separator = ",";
	bool		m_useStdout = false;
	string		m_filepath = string.Empty;

	public long DataExe(string filepath, string sep, Object[] fields)
	{
		m_separator = string.IsNullOrEmpty(sep) ? "," : sep;
		if(m_tw==null)
		{
			if(string.IsNullOrEmpty(filepath) || filepath.ToLower().Equals("stdout"))
			{
				m_useStdout = filepath.ToLower().Equals("stdout");
				filepath = System.IO.Path.GetTempFileName();
			}
			m_tw = new StreamWriter(filepath);
			m_filepath = filepath;
		}
		for(int i=0; i<fields.Length;i++)
		{
			string field = (string)fields[i];
			string finalField = field;
			if(field.Contains(m_separator))
			{
				finalField = field.Replace(@"""", @"""""");
				finalField = @"""" + finalField + @"""";
			}
			m_tw.Write(finalField);
			if(i < fields.Length -1)
			{
				m_tw.Write(m_separator);
			}
		}
		m_tw.Write(Environment.NewLine);
		return 1;
	}

	public long DataFetch(out string result)
	{
		result = "No data";
		if(m_tw==null)
		{
			return 1;
		}
		m_tw.Close();
		if(m_useStdout)
		{
			result = File.ReadAllText(m_filepath);
			File.Delete(m_filepath);
		}
		else
		{
			result = m_filepath;
		}
		m_tw = null;
		return 1;
	}

	public string ToXmlImport(string text, string sep, string tablename, string filepath, Object[] mappings)
	{
		USoft.UConvert.CSV csv = new USoft.UConvert.CSV();
		return csv.TOXMLIMPORT(text, sep, tablename, filepath, mappings);
	}
	public static string FromXmlImport(string xml, string separator, string filepath)
	{
		return USoft.UConvert.CSV.FromXmlExport(xml, separator, filepath);
	}
}]]></PROGRAM_SOURCE>
