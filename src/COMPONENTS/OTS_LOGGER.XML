		<PROGRAM_SOURCE><![CDATA[// OTS_LOGGER 2.0 - production logging for USoft rules, SQL tasks and jobs (USoft 11.2, .NET RDMI C# component).
//
// One call writes one line:
//   2026-10-03 14:22:01.123 [DEBUG] APP user=USER session=<pid>.<engine> tx=<pid>.<n> - message
// Default file: OTS_LOGGER.log in the USoft log folder (RulesEngine.GetProperty('USoftLogDir')).
// The level (OFF, ERROR, WARNING, INFORMATION, DEBUG) comes from the database table OTS_LOGGER_SETTING
// (wins) and/or a configuration file, re-read every REFRESH_SECONDS, so a change needs no rule change.
// Every public method returns the same constant (1, or the level test result for IsEnabled) and never
// throws: a failure to write is reported in a fallback file, never in the transaction.
using System;
using System.Collections.Generic;
using System.Data;
using System.Diagnostics;
using System.IO;
using System.Security.AccessControl;
using System.Security.Principal;
using System.Text;
using System.Threading;

public class OTS_LOGGER : RulesEngine
{
	// ------------------------------------------------------------------ levels
	private const int OFF = 0, ERROR = 1, WARNING = 2, INFORMATION = 3, DEBUG = 4;
	private static readonly string[] s_levelNames = { "OFF", "ERROR", "WARNING", "INFORMATION", "DEBUG" };

	// ------------------------------------------------------------------ defaults
	// Default file: OTS_LOGGER.log in the USoft log folder, RulesEngine.GetProperty('USoftLogDir') (the installation's
	// LogPath + USoft_logs, e.g. C:\USoft\USD11-Logs\USoft_logs\): the same folder in clients, batch and the Rules Service.
	// Without a Rules Engine to ask, or when it gives no folder: OTS_LOGGER.log in the configuration folder.
	// 1.x wrote C:\temp\mylog.log.
	private const string DEFAULT_FILE = "OTS_LOGGER.log";
	private const string LOGDIR_TOKEN = "{USOFTLOGDIR}";
	private const int DEFAULT_LEVEL = INFORMATION;              // 1.x wrote Information, Warning and Error
	private const long DEFAULT_MAX_SIZE_KB = 10240;
	private const int DEFAULT_MAX_FILES = 5;
	private const int DEFAULT_REFRESH_SECONDS = 5;
	private const string SETTINGS_TABLE = "OTS_LOGGER_SETTING";

	// ------------------------------------------------------------------ per instance
	// With Lifetime = Transaction (as installed) one instance lives for one transaction.
	private readonly string m_tx;
	private string m_owner;
	private string m_user;

	// ------------------------------------------------------------------ per process
	private static readonly object s_lock = new object();
	private static readonly Dictionary<string, Settings> s_settings = new Dictionary<string, Settings>(StringComparer.OrdinalIgnoreCase);
	private static readonly Dictionary<string, Mutex> s_mutexes = new Dictionary<string, Mutex>(StringComparer.OrdinalIgnoreCase);
	private static readonly Dictionary<string, long> s_reported = new Dictionary<string, long>(StringComparer.Ordinal);
	private static readonly Dictionary<string, int> s_lost = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
	private static readonly object s_noMutexLock = new object();
	private static readonly UTF8Encoding s_utf8 = new UTF8Encoding(false);
	private static readonly int s_pid = Environment.ProcessId;
	private static long s_txCounter = 0;
	private static string s_usoftLogDir;   // asked once per process; "" = could not be read
	private static int s_configCreateTried;   // 1 = this process already tried to create the configuration file

	private sealed class Settings
	{
		public int Level = DEFAULT_LEVEL;
		public string Path;   // null = the default file
		public long MaxBytes = DEFAULT_MAX_SIZE_KB * 1024;
		public int MaxFiles = DEFAULT_MAX_FILES;
		public int RefreshMs = DEFAULT_REFRESH_SECONDS * 1000;
		public bool UseDatabase = true;
		public string FallbackPath;
		public string SettingsTable = SETTINGS_TABLE;
		public string Source = "default";
		public long LoadedAt;
	}

	public OTS_LOGGER()
	{
		m_tx = s_pid + "." + Interlocked.Increment(ref s_txCounter);
	}

	// Called by the USoft .NET proxy before each method call (when it supports it).
	private void setUSoftOwnerUserRole(string owner, string user, string role)
	{
		m_owner = owner;
		m_user = user;
	}

	// ================================================================== RDMI methods
	// 1.x methods: same names, parameters and return value.
	public int WriteError(string message) { return Log(ERROR, message, null); }
	public int WriteWarning(string message) { return Log(WARNING, message, null); }
	public int WriteInformation(string message) { return Log(INFORMATION, message, null); }
	public int WriteErrorPath(string message, string filepath) { return Log(ERROR, message, filepath); }
	public int WriteWarningPath(string message, string filepath) { return Log(WARNING, message, filepath); }
	public int WriteInformationPath(string message, string filepath) { return Log(INFORMATION, message, filepath); }

	// 2.0 methods.
	public int WriteDebug(string message) { return Log(DEBUG, message, null); }
	public int WriteDebugPath(string message, string filepath) { return Log(DEBUG, message, filepath); }

	// Level by name: 'ERROR', 'WARNING', 'INFORMATION' (or 'INFO'), 'DEBUG'. An unknown name logs as INFORMATION.
	public int Write(string level, string message)
	{
		int l = ParseLevel(level);
		return Log(l <= OFF ? INFORMATION : l, message, null);
	}

	// 1 when a call at this level would write, else 0. Use it to skip building an expensive message.
	public int IsEnabled(string level)
	{
		try {
			int l = ParseLevel(level);
			if (l <= OFF) return 0;
			return l <= GetSettings(AppName(), false).Level ? 1 : 0;
		}
		catch (Exception) { return 0; }
	}

	// The effective settings and where they came from, for diagnostics.
	public string GetConfiguration()
	{
		try {
			string app = AppName();
			Settings s = GetSettings(app, false);
			return "level=" + s_levelNames[s.Level] + "; path=" + ExpandPath(s.Path, app) + "; max_size_kb=" + (s.MaxBytes / 1024)
				+ "; max_files=" + s.MaxFiles + "; refresh_seconds=" + (s.RefreshMs / 1000) + "; database=" + (s.UseDatabase ? "on" : "off")
				+ "; fallback_path=" + FallbackPath(s) + "; source=" + s.Source + "; config_file=" + (FindConfigFile(app) ?? "(none)")
				+ "; app=" + app + "; user=" + (m_user ?? "") + "; session=" + SessionId() + "; tx=" + m_tx;
		}
		catch (Exception e) { return "error: " + e.Message; }
	}

	// Re-read the settings now instead of at the next refresh. Returns 1.
	public int Reload()
	{
		try { GetSettings(AppName(), true); } catch (Exception) { }
		return 1;
	}

	// ================================================================== core
	private int Log(int level, string message, string explicitPath)
	{
		try {
			string app = AppName();
			Settings s = GetSettings(app, false);
			if (level > s.Level) return 1;   // OFF = 0: nothing is ever written
			string path = ExpandPath(string.IsNullOrEmpty(explicitPath) ? s.Path : explicitPath, app);
			string line = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff") + " [" + s_levelNames[level] + "] " + app
				+ " user=" + (m_user ?? "") + " session=" + SessionId() + " tx=" + m_tx + " - " + OneLine(message);
			Append(path, line, s);
		}
		catch (Exception e) {
			try { Fallback(null, "logging failed: " + e.GetType().Name + ": " + e.Message); } catch (Exception) { }
		}
		return 1;
	}

	private string AppName()
	{
		return string.IsNullOrEmpty(m_owner) ? "USOFT" : m_owner;
	}

	private string SessionId()
	{
		long engine = 0;
		try { engine = getEngine().ToInt64(); } catch (Exception) { }
		return s_pid + "." + engine.ToString("x");
	}

	private static string OneLine(string message)
	{
		if (message == null) return "(null)";
		return message.Replace("\r\n", "\\n").Replace("\n", "\\n").Replace("\r", "\\n");
	}

	private static int ParseLevel(string level)
	{
		if (level == null) return -1;
		switch (level.Trim().ToUpperInvariant()) {
			case "OFF": case "NONE": case "0": return OFF;
			case "ERROR": case "1": return ERROR;
			case "WARNING": case "WARN": case "2": return WARNING;
			case "INFORMATION": case "INFO": case "3": return INFORMATION;
			case "DEBUG": case "4": return DEBUG;
			default: return -1;
		}
	}

	private static string ExpandPath(string path, string app)
	{
		if (string.IsNullOrEmpty(path)) return DefaultPath();
		path = Environment.ExpandEnvironmentVariables(path).Replace("{APP}", app);
		int i = path.IndexOf(LOGDIR_TOKEN, StringComparison.OrdinalIgnoreCase);
		if (i >= 0) path = path.Substring(0, i) + LogDirOrConfigFolder() + path.Substring(i + LOGDIR_TOKEN.Length);
		return path;
	}

	private static string DefaultPath()
	{
		return Path.Combine(LogDirOrConfigFolder(), DEFAULT_FILE);
	}

	// The USoft log folder with a trailing backslash, or the configuration folder when it is unknown.
	private static string LogDirOrConfigFolder()
	{
		string d = s_usoftLogDir;
		if (string.IsNullOrEmpty(d)) d = ConfigFolder();
		return d.EndsWith("\\") ? d : d + "\\";
	}

	// On first use, when no configuration file exists, write the shared one with every key and its current value,
	// the log file path written out in full, so the settings can be read and changed without the source.
	// Once per process; never overwrites a file; a failure only goes to the fallback report.
	private void CreateConfigFileOnce()
	{
		if (Interlocked.Exchange(ref s_configCreateTried, 1) == 1) return;
		if (getEngine() == IntPtr.Zero) { s_configCreateTried = 0; return; }   // wait until USoftLogDir can be asked
		string file = Path.Combine(ConfigFolder(), "OTS_LOGGER.config");
		try {
			if (FindConfigFile("") != null || FindAnyAppConfig()) return;
			Directory.CreateDirectory(ConfigFolder());
			string nl = "\r\n";
			string text =
				"# OTS_LOGGER configuration, created " + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + " on first use." + nl +
				"# Read every refresh_seconds; a row in table OTS_LOGGER_SETTING overrides a key here (the database wins)." + nl +
				"# <APP>.config in this folder, or the file named by %OTS_LOGGER_CONFIG%, is used instead of this file." + nl +
				"# In path: {APP} = application name, {USOFTLOGDIR} = RulesEngine.GetProperty('USoftLogDir'), %VARIABLES%." + nl +
				nl +
				"# OFF, ERROR, WARNING, INFORMATION or DEBUG" + nl +
				"level=" + s_levelNames[DEFAULT_LEVEL] + nl +
				"# Default: OTS_LOGGER.log in the USoft log folder (" + LogDirOrConfigFolder() + ")" + nl +
				"path=" + DefaultPath() + nl +
				"# Rotate when the file would exceed this size (0 = never); keep this many rotated files" + nl +
				"max_size_kb=" + DEFAULT_MAX_SIZE_KB + nl +
				"max_files=" + DEFAULT_MAX_FILES + nl +
				"refresh_seconds=" + DEFAULT_REFRESH_SECONDS + nl +
				"# off = do not read table OTS_LOGGER_SETTING" + nl +
				"database=on" + nl +
				"# fallback_path=" + Path.Combine(ConfigFolder(), "OTS_LOGGER_fallback.log") + nl;
			byte[] b = s_utf8.GetBytes(text);
			// CreateNew: when two processes start at once, one writes the file and the other leaves it alone.
			using (var fs = new FileStream(file, FileMode.CreateNew, FileAccess.Write, FileShare.Read)) { fs.Write(b, 0, b.Length); }
		}
		catch (IOException) when (File.Exists(file)) { }
		catch (Exception e) { Report(null, "config-create", "could not create " + file + ": " + e.Message + "; the built-in defaults are used"); }
	}

	private static bool FindAnyAppConfig()
	{
		try { return Directory.Exists(ConfigFolder()) && Directory.GetFiles(ConfigFolder(), "*.config").Length > 0; }
		catch (Exception) { return false; }
	}

	// RulesEngine.GetProperty('USoftLogDir'), once per process. Asked in the caller's Rules Engine with its errors
	// caught, so a USoft version without this property cannot fail the calling statement.
	private void ResolveUsoftLogDir()
	{
		if (s_usoftLogDir != null || getEngine() == IntPtr.Zero) return;
		string dir = "";
		bool catching = false;
		try {
			try { Query("SELECT RulesEngine.StartCatchingErrors('Yes')"); catching = true; } catch (Exception) { }
			object r = QuerySingleField("SELECT RulesEngine.GetProperty('USoftLogDir')");
			string v = r == null || r == DBNull.Value ? "" : Convert.ToString(r).Trim();
			if (v.Length > 0 && Path.IsPathRooted(v)) dir = v;
		}
		catch (Exception) { }
		finally {
			if (catching) { try { Query("SELECT RulesEngine.StopCatchingErrors()"); } catch (Exception) { } }
		}
		if (dir.Length == 0) Report(null, "logdir", "RulesEngine.GetProperty('USoftLogDir') gave no folder; default log file is " + Path.Combine(ConfigFolder(), DEFAULT_FILE));
		s_usoftLogDir = dir;
	}

	// ================================================================== settings
	private Settings GetSettings(string app, bool force)
	{
		long now = Environment.TickCount64;
		Settings s;
		lock (s_lock) { s_settings.TryGetValue(app, out s); }
		if (!force && s != null && now - s.LoadedAt < s.RefreshMs) return s;
		Settings n = LoadSettings(app);
		n.LoadedAt = Environment.TickCount64;
		lock (s_lock) { s_settings[app] = n; }
		return n;
	}

	private static string ConfigFolder()
	{
		return Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData), "USoft", "OTS_LOGGER");
	}

	private static string FindConfigFile(string app)
	{
		string env = Environment.GetEnvironmentVariable("OTS_LOGGER_CONFIG");
		if (!string.IsNullOrEmpty(env) && File.Exists(env)) return env;
		string perApp = Path.Combine(ConfigFolder(), app + ".config");
		if (File.Exists(perApp)) return perApp;
		string shared = Path.Combine(ConfigFolder(), "OTS_LOGGER.config");
		if (File.Exists(shared)) return shared;
		return null;
	}

	private Settings LoadSettings(string app)
	{
		ResolveUsoftLogDir();
		CreateConfigFileOnce();
		Settings s = new Settings();
		var sources = new List<string>();
		// 1. configuration file
		string file = null;
		try {
			file = FindConfigFile(app);
			if (file != null) {
				foreach (string raw in File.ReadAllLines(file)) {
					string l = raw.Trim();
					if (l.Length == 0 || l.StartsWith("#") || l.StartsWith(";")) continue;
					int eq = l.IndexOf('=');
					if (eq <= 0) continue;
					Apply(s, l.Substring(0, eq), l.Substring(eq + 1), "file " + file, app);
				}
				sources.Add("file");
			}
		}
		catch (Exception e) {
			Report(s, "config:" + file, "could not read configuration file " + file + ": " + e.Message);
		}
		// 2. database setting: wins over the file, key by key
		if (s.UseDatabase && getEngine() != IntPtr.Zero && !DatabaseRecentlyFailed(app)) {
			// The query runs in the caller's Rules Engine. A failing query (table not installed) puts an
			// error on the engine's message stack that fails the calling statement, even though no
			// exception reaches this code; catching the engine's errors around it prevents that.
			bool catching = false;
			string failure = null;
			try {
				try { Query("SELECT RulesEngine.StartCatchingErrors('Yes')"); catching = true; } catch (Exception) { }
				// A table that is in the model but not created in the database gives an RDBMS error, which
				// still makes the calling statement return no rows (tested on 11.2.1, also while catching).
				// On SQL Server, ask the database first: OBJECT_ID never fails.
				if (IsSqlServer()) {
					object id = QuerySingleField("SELECT NVL(NUMBERTOCHAR(OBJECT_ID($$RDBMSOWNER$$ || '." + s.SettingsTable + "')), 'NONE')");
					if (id == null || id == DBNull.Value || Convert.ToString(id).Trim() == "NONE")
						throw new Exception("table " + s.SettingsTable + " does not exist in the database (run Create Tables)");
				}
				DataTable t = Query("SELECT SETTING_NAME, SETTING_VALUE FROM " + s.SettingsTable);
				if (catching) {
					object caught = null;
					try { caught = QuerySingleField("SELECT RulesEngine.GetLastCaughtErrors()"); } catch (Exception) { }
					string c = caught == null || caught == DBNull.Value ? "" : Convert.ToString(caught).Trim();
					if (c.Length > 0) failure = c;
				}
				if (failure == null) {
					int n = 0;
					foreach (DataRow r in t.Rows) {
						if (r[0] == DBNull.Value || r[1] == DBNull.Value) continue;
						string v = Convert.ToString(r[1]);
						if (string.IsNullOrWhiteSpace(v)) continue;
						Apply(s, Convert.ToString(r[0]), v, "database", app);
						n++;
					}
					if (n > 0) sources.Add("database");
				}
			}
			catch (Exception e) { failure = e.Message; }
			finally {
				if (catching) { try { Query("SELECT RulesEngine.StopCatchingErrors()"); } catch (Exception) { } }
			}
			if (failure != null) {
				lock (s_lock) { s_dbFailedAt[app] = Environment.TickCount64; }
				Report(s, "db:" + app, "could not read OTS_LOGGER_SETTING (" + OneLine(failure) + "); using the file or default settings, retrying in "
					+ (DB_RETRY_MS / 1000) + " s. Set database=off in the configuration file if the table is not installed.");
			}
		}
		s.Source = sources.Count == 0 ? "default" : string.Join("+", sources);
		return s;
	}

	private const int DB_RETRY_MS = 60000;
	private static readonly Dictionary<string, long> s_dbFailedAt = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);

	private bool? m_isSqlServer;

	private bool IsSqlServer()
	{
		if (m_isSqlServer == null) {
			object r = null;
			try { r = QuerySingleField("SELECT RulesEngine.GetProperty('Rdbms')"); } catch (Exception) { }
			m_isSqlServer = r != null && Convert.ToString(r).IndexOf("SQL Server", StringComparison.OrdinalIgnoreCase) >= 0;
		}
		return m_isSqlServer.Value;
	}

	private static bool DatabaseRecentlyFailed(string app)
	{
		lock (s_lock) {
			long at;
			return s_dbFailedAt.TryGetValue(app, out at) && Environment.TickCount64 - at < DB_RETRY_MS;
		}
	}

	private static void BadValue(Settings s, string key, string value, string where)
	{
		Report(s, "value:" + where + key + value, "invalid value '" + value + "' for " + key + " in " + where + "; kept the previous value");
	}

	private void Apply(Settings s, string key, string value, string where, string app)
	{
		key = key.Trim().ToUpperInvariant();
		value = value.Trim();
		long num;
		switch (key) {
			case "LEVEL":
				int l = ParseLevel(value);
				if (l >= 0) s.Level = l;
				else Report(s, "level:" + where + value, "unknown level '" + value + "' in " + where + "; kept " + s_levelNames[s.Level]);
				break;
			case "PATH": if (value.Length > 0) s.Path = value; break;
			case "MAX_SIZE_KB": if (long.TryParse(value, out num) && num >= 0) s.MaxBytes = num * 1024; else BadValue(s, key, value, where); break;
			case "MAX_FILES": if (long.TryParse(value, out num) && num >= 0 && num <= 100) s.MaxFiles = (int)num; else BadValue(s, key, value, where); break;
			case "REFRESH_SECONDS": if (long.TryParse(value, out num) && num >= 0 && num <= 3600) s.RefreshMs = (int)num * 1000; else BadValue(s, key, value, where); break;
			case "DATABASE": s.UseDatabase = !(value.Equals("off", StringComparison.OrdinalIgnoreCase) || value.Equals("no", StringComparison.OrdinalIgnoreCase) || value == "0"); break;
			case "FALLBACK_PATH": if (value.Length > 0) s.FallbackPath = value; break;
			case "SETTINGS_TABLE": if (System.Text.RegularExpressions.Regex.IsMatch(value, "^[A-Za-z_][A-Za-z0-9_]{0,29}$")) s.SettingsTable = value.ToUpperInvariant(); else BadValue(s, key, value, where); break;
			default: break;   // unknown keys are ignored, so newer files work with older versions
		}
	}

	// ================================================================== writing
	private static void Append(string path, string line, Settings s)
	{
		string full = Path.GetFullPath(path);
		byte[] bytes = s_utf8.GetBytes(line + "\r\n");
		Mutex m = GetMutex(full);
		bool owned = false;
		try {
			if (m != null) {
				try { owned = m.WaitOne(2000); }
				catch (AbandonedMutexException) { owned = true; }
			}
			if (m == null) Monitor.Enter(s_noMutexLock);
			try {
				Rotate(full, bytes.Length, s);
				WriteBytes(full, bytes);
				int lost = 0;
				lock (s_lock) { if (s_lost.TryGetValue(full, out lost)) s_lost.Remove(full); }
				if (lost > 0) Fallback(s, "writing to " + full + " works again; " + lost + " line(s) were lost before");
			}
			finally { if (m == null) Monitor.Exit(s_noMutexLock); }
		}
		catch (Exception e) {
			int lost;
			lock (s_lock) { s_lost.TryGetValue(full, out lost); s_lost[full] = ++lost; }
			Report(s, "write:" + full, "could not write to " + full + " (" + e.GetType().Name + ": " + e.Message + "); " + lost + " line(s) lost so far. Line: " + line);
		}
		finally {
			if (owned) { try { m.ReleaseMutex(); } catch (Exception) { } }
		}
	}

	private static void WriteBytes(string full, byte[] bytes)
	{
		for (int attempt = 0; ; attempt++) {
			try {
				// Append mode + one Write call: the line is appended in one piece, also by other processes.
				using (var fs = new FileStream(full, FileMode.Append, FileAccess.Write, FileShare.ReadWrite | FileShare.Delete, 4096, FileOptions.None)) {
					fs.Write(bytes, 0, bytes.Length);
				}
				return;
			}
			catch (DirectoryNotFoundException) {
				if (attempt > 0) throw;
				Directory.CreateDirectory(Path.GetDirectoryName(full));
			}
			catch (IOException) {
				if (attempt >= 3) throw;
				Thread.Sleep(20 * (attempt + 1));
			}
		}
	}

	private static string RotatedName(string full, int i)
	{
		string dir = Path.GetDirectoryName(full);
		return Path.Combine(dir, Path.GetFileNameWithoutExtension(full) + "." + i + Path.GetExtension(full));
	}

	private static void Rotate(string full, int adding, Settings s)
	{
		if (s.MaxBytes <= 0) return;
		var fi = new FileInfo(full);
		if (!fi.Exists || fi.Length + adding <= s.MaxBytes) return;
		try {
			if (s.MaxFiles <= 0) { File.Delete(full); return; }
			string oldest = RotatedName(full, s.MaxFiles);
			if (File.Exists(oldest)) File.Delete(oldest);
			for (int i = s.MaxFiles - 1; i >= 1; i--) {
				string from = RotatedName(full, i);
				if (File.Exists(from)) File.Move(from, RotatedName(full, i + 1));
			}
			File.Move(full, RotatedName(full, 1));
		}
		catch (Exception e) {
			Report(s, "rotate:" + full, "could not rotate " + full + ": " + e.Message + "; the file keeps growing until rotation works");
		}
	}

	private static Mutex GetMutex(string full)
	{
		lock (s_lock) {
			Mutex m;
			if (s_mutexes.TryGetValue(full, out m)) return m;
			m = CreateMutex("Global\\OTS_LOGGER_" + Fnv1a(full.ToLowerInvariant()));
			s_mutexes[full] = m;   // null is cached too: then this process relies on append-mode writes
			return m;
		}
	}

	private static Mutex CreateMutex(string name)
	{
		try {
			// Everyone may use it: a Rules Service (LocalSystem) and a user's client share one log file.
			var sec = new MutexSecurity();
			sec.AddAccessRule(new MutexAccessRule(new SecurityIdentifier(WellKnownSidType.WorldSid, null),
				MutexRights.Synchronize | MutexRights.Modify, AccessControlType.Allow));
			bool created;
			return MutexAcl.Create(false, name, out created, sec);
		}
		catch (Exception) { }
		try { return Mutex.OpenExisting(name); } catch (Exception) { }
		try { return new Mutex(false, name); } catch (Exception) { }
		Report(null, "mutex:" + name, "no named mutex " + name + "; writing with append mode only");
		return null;
	}

	// A stable hash: string.GetHashCode() differs per process in .NET.
	private static string Fnv1a(string s)
	{
		ulong h = 14695981039346656037UL;
		foreach (char c in s) { h ^= c; h *= 1099511628211UL; }
		return h.ToString("x16");
	}

	// ================================================================== fallback reporting
	private static string FallbackPath(Settings s)
	{
		if (s != null && !string.IsNullOrEmpty(s.FallbackPath)) return Environment.ExpandEnvironmentVariables(s.FallbackPath);
		return Path.Combine(ConfigFolder(), "OTS_LOGGER_fallback.log");
	}

	// At most one report per key per minute.
	private static void Report(Settings s, string key, string text)
	{
		long now = Environment.TickCount64;
		lock (s_lock) {
			long last;
			if (s_reported.TryGetValue(key, out last) && now - last < 60000) return;
			s_reported[key] = now;
		}
		Fallback(s, text);
	}

	private static void Fallback(Settings s, string text)
	{
		string line = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff") + " [OTS_LOGGER] pid=" + s_pid + " - " + OneLine(text);
		try { Trace.WriteLine(line); } catch (Exception) { }
		foreach (string p in new[] { FallbackPath(s), Path.Combine(Path.GetTempPath(), "OTS_LOGGER_fallback.log") }) {
			try {
				string dir = Path.GetDirectoryName(p);
				if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
				var fi = new FileInfo(p);
				if (fi.Exists && fi.Length > 5L * 1024 * 1024) File.Delete(p);
				byte[] b = s_utf8.GetBytes(line + "\r\n");
				using (var fs = new FileStream(p, FileMode.Append, FileAccess.Write, FileShare.ReadWrite | FileShare.Delete)) {
					fs.Write(b, 0, b.Length);
				}
				return;
			}
			catch (Exception) { }
		}
	}
