		<PROGRAM_SOURCE><![CDATA[using System;
using System.IO;

public class OTS_LOGGER
{
	private string m_filepath = "C:\\temp\\mylog.log";

	public int WriteInformation(string message)
    {
		return WritePrivate0(m_filepath, message, "Information");
    }

	public int WriteWarning(string message)
    {
		return WritePrivate0(m_filepath, message, "Warning");
    }

	public int WriteError(string message)
    {
		return WritePrivate0(m_filepath, message, "Error");
    }

	public int WriteInformationPath(string message, string filepath)
    {
		return WritePrivate0(filepath, message, "Information");
    }

	public int WriteWarningPath(string message, string filepath)
    {
		return WritePrivate0(filepath, message, "Warning");
    }

	public int WriteErrorPath(string message, string filepath)
    {
		return WritePrivate0(filepath, message, "Error");
    }

	private int WritePrivate0(string filepath, string message, string msgType)
	{
		if(string.IsNullOrEmpty(filepath))
			filepath = m_filepath;
		return WritePrivate(filepath, message, msgType);
	}

	private int WritePrivate(string filepath, string message, string msgType)
	{
		string logMessage = String.Format("{0:yyyy-MM-dd HH:mm:ss} [{2}] - {1}", DateTime.Now, message, msgType);
        // Log to file if a path is specified
        if (!string.IsNullOrEmpty(filepath))
        {
            try
            {
                File.AppendAllText(filepath, logMessage + Environment.NewLine);
            }
            catch (Exception ex)
            {
				throw new Exception(String.Format("Failed to write to log file: {0}", ex.Message));
            }
        }
		return 1;
	}
}]]></PROGRAM_SOURCE>
