		<PROGRAM_SOURCE><![CDATA[<?xml version="1.0" encoding="UTF-8" ?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:strings="USoft:Strings" xmlns:xslutil="USoft:XslUtil">
	<xsl:output method="text" version="1.0" indent="yes"/>

	<xsl:template match="/">
		<xsl:value-of select="'{'"/>
		<xsl:variable name="results">
			<xsl:element name="results">
				<xsl:for-each select="//Row">
					<xsl:variable name="columnName" select="Field[@alias='COLUMN_NAME']"/>
					<xsl:variable name="selectStatement" select="Field[@alias='DEFAULT_VALUE_SQL']"/>
					<xsl:variable name="row" select="document(concat('invoke xml.sqlexport with ', $selectStatement))/*/Rows/Row"/>
					<xsl:variable name="value" select="$row/Field"/>

					<xsl:if test="count($row) = 1">
						<xsl:element name="result">
							<xsl:attribute name="columnName">
								<xsl:value-of select="$columnName"/>
							</xsl:attribute>
							<xsl:attribute name="value">
								<xsl:value-of select="$value"/>
							</xsl:attribute>
						</xsl:element>
					</xsl:if>
				</xsl:for-each>
			</xsl:element>
		</xsl:variable>

		<xsl:for-each select="xslutil:nodeset($results, .)//result">
			<xsl:variable name="columnName" select="@columnName"/>
			<xsl:variable name="value" select="@value"/>

			<xsl:if test="position()!=1">, </xsl:if>
			<xsl:value-of select="concat('&quot;',$columnName, '&quot;', ': ', '&quot;', $value, '&quot;')"/>
		</xsl:for-each>
		<xsl:value-of select="'}'"/>
	</xsl:template>
</xsl:stylesheet>]]></PROGRAM_SOURCE>
