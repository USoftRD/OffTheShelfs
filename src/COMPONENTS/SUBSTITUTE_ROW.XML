		<PROGRAM_SOURCE><![CDATA[<?xml version="1.0" encoding="UTF-8" ?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:strings="USoft:Strings">
	<xsl:output method="text" version="1.0" indent="yes"/>

	<xsl:param name="selectStatement"/>
	<xsl:param name="namePrefix" select="''"/>

	<xsl:template match="/">
		<xsl:variable name="substituted">
			<xsl:call-template name="substituteAll">
				<xsl:with-param name="statement" select="$selectStatement"/>
				<xsl:with-param name="depth" select="1"/>
			</xsl:call-template>
		</xsl:variable>

		<xsl:value-of select="$substituted"/>

	</xsl:template>

	<xsl:template name="substituteAll">
		<xsl:param name="statement"/>
		<xsl:param name="depth"/>

		<xsl:choose>
			<xsl:when test="$depth &gt; count(//item)">
				<xsl:value-of select="$statement"/>
			</xsl:when>
			<xsl:otherwise>
				<xsl:variable name="item" select="//item[$depth]"/>
				<xsl:variable name="hostvar" select="concat(':', $namePrefix, $item/@name)"/>
				<xsl:variable name="value" select="$item"/>
				<xsl:variable name="apos">'</xsl:variable>
				<xsl:call-template name="substituteAll">
					<xsl:with-param name="statement" select="strings:Replace($statement, $hostvar, concat($apos, $value, $apos))"/>
					<xsl:with-param name="depth" select="$depth + 1"/>
				</xsl:call-template>
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>

</xsl:stylesheet>]]></PROGRAM_SOURCE>
