		<DESCRIPTION><![CDATA[This OTS_WIN_NETWORK component interacts with the Windows network.
A table component OTS_WIN_NETWORK is also available to instantly query networks as records.
Once the OTS_WIN_NETWORK component is added to the USoft Definer you can:
	-Open the application and query the Windows Network table (i.e. the OTS_WIN_NETWORK table)
	-Open SqlCommand in the application and use method calls.

Method call examples:

select OTS_WIN_NETWORK.hostname()

select OTS_WIN_NETWORK.DnsHostAddresses('localhost')

select OTS_WIN_NETWORK.LocalIPAddress()

select OTS_WIN_NETWORK.WIFIADDRESS()

select OTS_WIN_NETWORK.IsNetworkAvailable()

select OTS_WIN_NETWORK.ListNetwork()

invoke OTS_WIN_NETWORK.Query with select null

select OTS_WIN_NETWORK.Wifi()

select OTS_WIN_NETWORK.wificonnected('USoftGuest')

select OTS_WIN_NETWORK.ping('localhost')]]></DESCRIPTION>
	</T_RDMI_COMPONENT_CONSTRUCTOR>
</Component_Constructors><DotNet_Components documentName="DotNet Components">
	<T_RDMI_DOTNET_COMPONENT COMPONENT_NAME="OTS_WIN_NETWORK" DOTNET_ACTIVE="Y" LANGUAGE="C#" APP_DOMAIN="Default" INCLUDE_WINDOWS_APP_DLL="N" INTERFACE="N" MODULE="" INTERFACE_CORRECT="Y" CREATED_BY="RDMI91" CREATED_ON="2020-01-11T22:18:32" G_U_K="71DF3CBFD55645ECA474DD6D81F6FF00">
		<ASSEMBLYREFS><![CDATA[]]></ASSEMBLYREFS>
		<PROGRAM_SOURCE><![CDATA[using System;
using System.Xml.XPath;
using USoft.Net;

class OTS_WIN_NETWORK
{
	XPathNodeIterator m_nodes;

	public string HostName()
	{
		return WNetwork.HostName();
	}
	public string LocalIPAddress()
	{
		return WNetwork.LocalIPAddress();
	}
	public string DnsHostAddresses(string hostname)
	{
		XPathNodeIterator n = WNetwork.DnsHostAddresses(hostname);
		if(!n.MoveNext())
		{
			return string.Empty;
		}
		return n.Current.InnerXml;
	}
	public bool IsNetworkAvailable()
	{
		return WNetwork.IsNetworkAvailable();
	}
	public string WifiAddress()
	{
		XPathNodeIterator n = WNetwork.ListNetwork();
		if(!n.MoveNext())
		{
			return string.Empty;
		}
		XPathNodeIterator wifis = n.Current.Select("/NetworkInfo/Adapter[@OperationalStatus='Up'][contains(@NetworkInterfaceType, 'Wireless')]/*[contains(name(),'IPAd')]"); 
		// IPADDRESS but old version had spelling error IPAdress
		if(!wifis.MoveNext())
		{
			return string.Empty;
		}
		string address = wifis.Current.GetAttribute("Address", string.Empty);
		if(string.IsNullOrEmpty(address)) address = wifis.Current.GetAttribute("Adress", string.Empty);
		return address;
	}
	public string ListNetwork()
	{
		XPathNodeIterator n = WNetwork.ListNetwork();
		if(!n.MoveNext()) return string.Empty;
		return n.Current.InnerXml;
	}
	public string Wifi()
	{
		XPathNodeIterator n = WNetwork.wifi();
		if(!n.MoveNext()) return string.Empty;
			return n.Current.InnerXml;
	}
	public bool WifiConnected(string ssid)
	{
		XPathNodeIterator n = WNetwork.wifi();
		if(!n.MoveNext()) return false;
		XPathNodeIterator connectedwifi = n.Current.Select(string.Format("//nic[@ssid='{0}']", ssid));
		if(!connectedwifi.MoveNext()) return false;
		return true;
	}
	// returns IPStatus (e.g. Success) followed by roundtrip time in milliseconds 
	public string Ping(string hostname)
	{
		return WNetwork.Ping(hostname);
	}
	public int QueryExe(string dummy)
	{
		XPathNodeIterator n = WNetwork.ListNetwork();
		if(!n.MoveNext()) return 0;
		m_nodes = n.Current.Select("//Adapter");
		return 1;
	}
	public int QueryFetch(out string name, out string status, out string interfaceType, out string description, out string IPAddress, out string GWAddress)
	{
		name = status = interfaceType = description = IPAddress = GWAddress = string.Empty;
		if(!m_nodes.MoveNext()) return 0;
		name = m_nodes.Current.GetAttribute("Name", string.Empty);
		status = m_nodes.Current.GetAttribute("OperationalStatus", string.Empty);
		interfaceType = m_nodes.Current.GetAttribute("NetworkInterfaceType", string.Empty);
		description = m_nodes.Current.GetAttribute("Description", string.Empty);
		XPathNodeIterator itIPAddress = m_nodes.Current.Select("IPAddress");
		if(itIPAddress.MoveNext())
		{
			IPAddress = itIPAddress.Current.GetAttribute("Address", string.Empty);
		}
		XPathNodeIterator itGWAddress = m_nodes.Current.Select("Address");
		if(itGWAddress.MoveNext())
		{
			GWAddress = itGWAddress.Current.GetAttribute("Address", string.Empty);
		}
		return 1;
	}
}]]></PROGRAM_SOURCE>
