	/* helper method to report the tags in a template document */
	public string ControlInfo(string template_filepath)
	{
		StringBuilder result = new StringBuilder();
		FileStream report_stream = File.Open(template_filepath,  FileMode.Open,  FileAccess.Read, FileShare.ReadWrite);
		try
		{
			Stream word_doc_stream = GetDocumentStream(report_stream, true);
			XmlDocument word_doc = CreateXmlDocumentFromStream(word_doc_stream);
			XmlNamespaceManager nsmgr = new XmlNamespaceManager(word_doc.NameTable);
			nsmgr.AddNamespace("w", m_ro_word_ns);
			XmlNodeList content_controls = word_doc.SelectNodes("descendant::w:sdt[w:sdtPr[w:tag]]", nsmgr);
			Addlabels(result, content_controls, nsmgr, 0);
		}
		catch (Exception ex)
		{
			throw new Exception("ControlInfo: " + ex.Message);
		}
		finally
		{
			report_stream.Close();
		}
		return result.ToString();
	}
	private void Addlabels(StringBuilder result, XmlNodeList content_controls, XmlNamespaceManager nsmgr, int nesting)
	{
			foreach(XmlNode n in content_controls)
			{
				XmlNodeList ancestors = n.SelectNodes("ancestor::w:sdt[w:sdtPr[w:tag]]", nsmgr);
				if(ancestors.Count > nesting)
				{
					continue;
				}
				string content_control_name = n.SelectNodes("w:sdtPr/w:tag", nsmgr)[0].Attributes["val", m_ro_word_ns].Value;
				for(int i=0; i<nesting; i++)
				{
					result.Append("	");
				}
				result.Append(content_control_name + Environment.NewLine);
				XmlNodeList table_content_controls = n.SelectNodes("descendant::w:sdt[w:sdtPr[w:tag]]", nsmgr);
				Addlabels(result, table_content_controls, nsmgr, nesting + 1); 
			}
	}
	public string Run(string template_filepath, string report_filepath, Object[] args)
	{
		if (!File.Exists(template_filepath)) 
		{
			throw new Exception("Word template file " + template_filepath + " does not exist.");
		}
		if(string.IsNullOrEmpty(report_filepath))
		{ 
			report_filepath = Path.GetTempFileName() + ".docx";
		}
		if(FileIsOpen(report_filepath))
		{
			throw new Exception(string.Format("File {0} is currently open.", report_filepath));
		}
		File.Copy(template_filepath, report_filepath, true); // warning: this possibly overwrites an existing file
		if(args == null)
		{
			return report_filepath; 
		}
		FileStream report_stream = File.Open(report_filepath, FileMode.Open, FileAccess.ReadWrite);
		Dictionary<string, object> namevalues = new Dictionary<string, object>();
		if(args.Length == 1)
		{
			string xmldata = ((string)args[0]).Trim();
			XmlDocument xmldoc = new XmlDocument();
			if(xmldata.StartsWith("<")) 
			{
				xmldoc.LoadXml(xmldata);
			}
			else
			{
				xmldoc.Load(xmldata);
			}
			/* read propriety xml format with tagname - value structure  */
			foreach (XmlNode xml_data_node in xmldoc.DocumentElement.ChildNodes)
			{
				string name = "Table".Equals(xml_data_node.Name, StringComparison.OrdinalIgnoreCase) ? xml_data_node.Attributes["NAME"].Value : xml_data_node.Name;
				string value = string.IsNullOrEmpty(xml_data_node.Value) ? xml_data_node.InnerXml : xml_data_node.Value;
				AddArg2Dict(namevalues, name, value);
			}			
		}
		/* read values as name, value | table where table values are defined from xml.[sql]export */
		for(int i=0; args.Length > 1 && i< args.Length -1 ; i+=2)
		{
			AddArg2Dict(namevalues, (string)args[i], (string)args[i+1]);
		}
		try
		{
			Stream word_doc_stream = GetDocumentStream(report_stream, false);
			XmlDocument word_doc = CreateXmlDocumentFromStream(word_doc_stream);
			XmlNamespaceManager nsmgr = new XmlNamespaceManager(word_doc.NameTable);
			nsmgr.AddNamespace("w", m_ro_word_ns);
			FillAllControlData(word_doc, nsmgr, word_doc.SelectNodes("//w:body", nsmgr)[0], namevalues);
			word_doc_stream.Seek(0, SeekOrigin.Begin);//reset the stream-pointer
			word_doc_stream.SetLength(0);
			word_doc.Save(word_doc_stream);
		}
		catch (Exception ex)
		{
			throw new Exception("Run: " + ex.Message);
		}
		finally
		{
			report_stream.Close();
		}
		return report_filepath;
	}

	private void AddArg2Dict(Dictionary<string, object> namevalues, string name, string value)
	{
		XmlReaderSettings set = new XmlReaderSettings();
		set.ConformanceLevel = ConformanceLevel.Fragment;
		try
		{
			XPathDocument xmlfragment = new XPathDocument(XmlReader.Create(new StringReader(value), set));
			namevalues.Add(name, xmlfragment.CreateNavigator());
		}
		catch(Exception) 
		{
			namevalues.Add(name, value);
		}
	}

	private void FillAllControlData(XmlDocument word_doc, XmlNamespaceManager nsmgr, XmlNode word_doc_node, Dictionary<string, object> namevalues)
	{
		foreach(string name in namevalues.Keys)
		{
			FillControlData(word_doc, nsmgr, word_doc_node, name, namevalues[name]);
		}
	}

	private void FillControlData(XmlDocument word_doc, XmlNamespaceManager nsmgr, XmlNode word_doc_node, string name, object values)
	{
		if(values == null)
		{
			return;
		}
		XmlNodeList content_controls = word_doc_node.SelectNodes("descendant::w:sdt[w:sdtPr[w:tag[@w:val=\"" + name + "\"]]]", nsmgr);
		if (content_controls.Count == 0)
		{
			return;
		}
		XmlNode content_control = content_controls[0];		
		if (values.GetType() == typeof(string))
		{
			ReplaceRunClass(word_doc, nsmgr, content_control, name, (string)values);
			return;
		}
		if (!values.GetType().IsSubclassOf(typeof(XPathNavigator)))
		{
			return;
		}
		XPathNavigator nav = (XPathNavigator)values;
		if(nav.SelectSingleNode("*") == null)
		{
			ReplaceRunClass(word_doc, nsmgr, content_control, name, (string)nav.Value);
		}
		XmlNodeList rows = content_control.SelectNodes("descendant::w:tbl/w:tr[descendant::w:sdt]", nsmgr);
		if (rows.Count > 0)
		{	
			FillTable(word_doc, nsmgr, content_control, rows, (XPathNavigator)values);
		}
		else
		{
			//search if ia column control is found; if so repeat the whole content for each row
			SearchRowsInStdBlockContent(word_doc, nsmgr, content_control, (XPathNavigator)values);			
		}
	}

	private void FillTable(XmlDocument word_doc,  XmlNamespaceManager nsmgr, XmlNode content_control, XmlNodeList rows, XPathNavigator xmldoc)
	{
		XmlNode table = rows[0].ParentNode;
		XPathNavigator root = xmldoc.SelectSingleNode("/*");
		XPathNodeIterator table_rows = null;
		bool isxmlsqlexport = false;
		bool isxmlexport = false;
		switch(root.Name)
		{
			case "SQLXMLExport": 
				table_rows = xmldoc.Select("*/Rows/Row");
				isxmlsqlexport = true;
			break;
			case "Row":
				table_rows = xmldoc.Select("Row");
			break;
			default: 
				table_rows = xmldoc.Select("*/*");
				isxmlexport = true;
				break;
		}
		while (table_rows.MoveNext())
		{
			XmlNode template_row = rows[0].CloneNode(true);
			XPathNodeIterator xml_data_fields = isxmlsqlexport ?  table_rows.Current.Select("Field") : table_rows.Current.Select("* | @*");
			while (xml_data_fields.MoveNext())
			{
				if(isxmlsqlexport)
				{
					FillControlData(word_doc, nsmgr, template_row, xml_data_fields.Current.GetAttribute("alias", string.Empty), xml_data_fields.Current); 
				}
				else
				{
					FillControlData(word_doc, nsmgr, template_row, xml_data_fields.Current.Name, xml_data_fields.Current); 
				}
			}
			rows[0].ParentNode.AppendChild(template_row);
		}

		// Remove the prototype row and add all of the newly constructed rows.
		rows[0].ParentNode.RemoveChild(rows[0]);

		// Remove the content control for the table and replace it with its contents.
		XmlNodeList contents = content_control.SelectNodes("w:sdtContent", nsmgr);
		if (contents.Count == 0)
			return;

		XmlNodeList content_items = contents[0].ChildNodes;
		ArrayList childrenList = new ArrayList();

		foreach (XmlNode child in content_items)
		{
			childrenList.Add(child);
		}
		foreach(XmlNode child in childrenList)
		{
			content_control.ParentNode.InsertBefore(child, content_control);
		}
		content_control.ParentNode.RemoveChild(content_control);
		XmlNodeList sdts = table.SelectNodes("descendant::w:sdt", nsmgr);
		foreach (XmlNode s in sdts)
		{
			s.ParentNode.RemoveChild(s);
		}
	}
	private void SearchRowsInStdBlockContent(XmlDocument word_doc, XmlNamespaceManager nsmgr, XmlNode content_control, XPathNavigator xmldoc)
	{
		XmlNodeList rows = content_control.SelectNodes("descendant::w:sdt", nsmgr);
		if (rows.Count == 0)
			return;

		XmlNodeList contents = content_control.SelectNodes("w:sdtContent", nsmgr);
		if (contents.Count == 0)
				return;

		XPathNodeIterator table_rows = xmldoc.Select("Row");
		while (table_rows.MoveNext())
		{
			XmlNode template_row = contents[0].CloneNode(true);
			XPathNodeIterator table_fields = table_rows.Current.Select("*");
			while (table_fields.MoveNext())
			{
				FillControlData(word_doc, nsmgr, template_row, table_fields.Current.Name, table_fields.Current);
			}
			XmlNodeList content = template_row.ChildNodes;
			while (content.Count > 0)
			{
				rows[0].ParentNode.InsertBefore(content[0], rows[0]);
			}
		}

		// Remove the prototype row and add all of the newly constructed rows.
		rows[0].ParentNode.RemoveChild(rows[0]);
	}

	private void ReplaceRunClass(XmlDocument word_doc, XmlNamespaceManager nsmgr, XmlNode content_control,  string name, string text)
	{
		// Replace the run (Phonetic Guide Text Run, w:r, Run Class) in the structured data type with the new value.
		XmlNodeList run = content_control.SelectNodes("w:sdtContent//w:r", nsmgr);
		if (run.Count == 0)
			return;

		XmlNodeList datenodes = content_control.SelectNodes("descendant::w:date", nsmgr);
		bool isdate = datenodes.Count > 0;
		string dateformat = "yyyy-MM-dd'T'HH:mm:ss";
		DateTime dt = DateTime.Now;
		if(isdate)
		{
			if(!DateTime.TryParseExact(text, 
				m_formats,
				CultureInfo.InvariantCulture, 
				DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, 
				out dt)
			)
			{
				isdate = false;
			}
		}
		if(isdate)
		{
			XmlNode dateformatnode = content_control.SelectSingleNode("descendant::w:date/w:dateFormat/@w:val", nsmgr);
			if(dateformatnode != null)
			{
				dateformat = dateformatnode.Value;
			}
		}
		//get run properties
		XmlNodeList runProperties = run[0].SelectNodes("w:rPr", nsmgr);

		XmlNode p = run[0].ParentNode;
		RemoveChildNodes(p);
		XmlNode r = word_doc.CreateElement("w:r", m_ro_word_ns);
		if(!isdate)
		{
			r.InnerXml = "<w:t xmlns:w=\"" + m_ro_word_ns + "\">" + text.Replace("\r\n", "</w:t><w:br xmlns:w=\"" + m_ro_word_ns + "\"/><w:t xmlns:w=\"" + m_ro_word_ns + "\">") + "</w:t>";
		}
		else
		{
			r.InnerXml = "<w:t xmlns:w=\"" + m_ro_word_ns + "\">" + dt.ToString(dateformat) + "</w:t>";
		}
		if (runProperties.Count > 0)
		{
			r.InsertBefore(runProperties[0], r.FirstChild);
		}
		p.AppendChild(r);

		XmlNodeList contents = content_control.SelectNodes("w:sdtContent", nsmgr);
		if (contents.Count == 0)
			return;

		content_control.ParentNode.ReplaceChild(contents[0].FirstChild, content_control);
	}

	private void RemoveChildNodes(XmlNode node)
	{ 
		ArrayList childrenList = new ArrayList();
		foreach(XmlNode child in node.ChildNodes)
		{
			childrenList.Add(child);
		}
		foreach (XmlNode child in childrenList)
		{
			child.ParentNode.RemoveChild(child);
		}
	}
	private Stream GetDocumentStream(Stream report_stream, bool ro)
	{
		Package pckg = ro ? 
			Package.Open(report_stream, FileMode.Open, FileAccess.Read) :
			Package.Open(report_stream, FileMode.Open, FileAccess.ReadWrite);
		//  Get the main document part (document.xml)
		foreach (System.IO.Packaging.PackageRelationship relationship in pckg.GetRelationshipsByType(m_ro_document_relationship_type))
		{
			PackagePart documentPart = pckg.GetPart(PackUriHelper.ResolvePartUri(new Uri("/", UriKind.Relative), relationship.TargetUri));
			return documentPart.GetStream(); //There should only be one document part in the package. 
		}
		throw new Exception("The document.xml part was not found");
	}
	private XmlDocument CreateXmlDocumentFromStream(Stream s)
	{
		XmlDocument xmldoc = new XmlDocument();
		xmldoc.Load(s);
		return xmldoc;
	}
	public bool FileIsOpen(string path)
	{
		if(!File.Exists(path))	
		{
			return false;
		}
		System.IO.FileStream a = null;
		try
		{
			a = System.IO.File.Open(path,
			System.IO.FileMode.Open, System.IO.FileAccess.Read, System.IO.FileShare.None);
			return false;
		}
		catch (System.IO.IOException ex)
		{
			return true;
		}
		finally
		{
			if (a != null)
			{
				a.Close();
				a.Dispose();
			}
		}
	}
}]]></PROGRAM_SOURCE>
