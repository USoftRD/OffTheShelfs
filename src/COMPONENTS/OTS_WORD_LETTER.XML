		<PROGRAM_SOURCE><![CDATA[using System;
using System.Text;
using System.IO;
using System.IO.Packaging;
using System.Xml;
using System.Xml.XPath;
using System.Collections;
using System.Collections.Generic;
using System.Globalization;

class OTS_WORD_LETTER
{
