		<PROGRAM_SOURCE><![CDATA[using System;
using System.IO;
using System.Text;
using System.Collections.Generic;
using System.Xml;
using System.Xml.Schema;

class OTS_XSD_SCHEMA
{
	public string Validate(string schemafile, string xmlfile)
	{
		if(schemafile.StartsWith("<"))
		{
			string schemafilepath = System.IO.Path.GetTempFileName();
			File.WriteAllText(schemafilepath, schemafile);
			schemafile = schemafilepath;
		}
		Schema  schema= new Schema(schemafile); //if missing: Value cannot be null. Parameter name: schemaUri
		List<string> flaws = schema.Validate(xmlfile);
		if(flaws.Count > 0)
		{
			StringBuilder result = new StringBuilder();
			foreach (string flaw in flaws)
			{
				result.Append(flaw).Append(Environment.NewLine);
			}
			return result.ToString(); 
		}
		return "Valid";
	}
}

class Schema
{
	List<string> m_flaws;
	string m_schemaxml;
	public Schema(string schema)
	{
		m_schemaxml = schema;
	}
	private  void ValidationCallBack(object sender,  ValidationEventArgs e) 
	{
		m_flaws.Add(e.Message);
	} 
	public  List<string> Validate(string xmldoc)
	{
		try 
		{ 
			m_flaws = new List<string>();
	 		XmlDocument xmld=new XmlDocument (); 
			if (xmldoc.StartsWith("<"))
				xmld.LoadXml(xmldoc); 
			else
				xmld.Load(xmldoc); 
			xmld.Schemas.Add(null, m_schemaxml); 
			xmld.Validate(ValidationCallBack); 
			return m_flaws;
		} 
		catch (Exception ex)
		{ 
			List<string> result = new List<string>();
			result.Add(ex.Message);
			return result;
		} 
	}
}]]></PROGRAM_SOURCE>
