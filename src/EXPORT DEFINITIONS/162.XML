<Export_Definitions documentName="Export Definitions">
	<T_EXP_DEF EXPORT_ID="162" EXPORT_NAME="OTS_FILE_WATCH" DEFINED_BY="P3100027" DEF_FILE_NAME="C:\OTS_GITHUB\OffTheShelfs\OTS_FILE_WATCH\OTS_FILE_WATCH.xml" EXP_RES_WORDS="N">
		<COMMENTS><![CDATA[This component will listen to file system events in a specified directory.
Optionally, a file filter can also be specified.

To start listening to file change events, e.g. in a directory c:\temp:

select OTS_FILE_WATCH.Start('c:\temp\', '')

To start listening to txt files only:

select OTS_FILE_WATCH.Start('c:\temp\', '*.txt')

To see results:

invoke OTS_FILE_WATCH.query with select ''

A query only component table can be created for this component.]]></COMMENTS>
	</T_EXP_DEF>
