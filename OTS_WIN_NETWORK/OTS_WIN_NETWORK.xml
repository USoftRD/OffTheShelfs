    <T_RDMI_DOTNET_COMPONENT COMPONENT_NAME="OTS_WIN_NETWORK" DESCRIPTION="This OTS_WIN_NETWORK component interacts with the Windows network.&#xD;&#xA;A table component OTS_WIN_NETWORK is also available to instantly query networks as records.&#xD;&#xA;Once the OTS_WIN_NETWORK component is added to the USoft Definer you can:&#xD;&#xA;&#x9;-Open the application and query the Windows Network table (i.e. the OTS_WIN_NETWORK table)&#xD;&#xA;&#x9;-Open SqlCommand in the application and use method calls.&#xD;&#xA;&#xD;&#xA;Method call examples:&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.hostname()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.DnsHostAddresses('localhost')&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.LocalIPAddress()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.WIFIADDRESS()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.IsNetworkAvailable()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.ListNetwork()&#xD;&#xA;&#xD;&#xA;invoke OTS_WIN_NETWORK.Query with select null&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.Wifi()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.wificonnected('USoftGuest')&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.ping('localhost')" T_RDMI_JAVA_COMPONENT="N" T_RDMI_STATEFUL_COMPONENT="Y" INTERFACE="N" MODULE="" INTERFACE_CORRECT="Y" T_RDMI_WEB_SERVICE_COMPONENT="N" T_RDMI_DOTNET_COMPONENT="Y" T_RDMI_COMPONENT_CONSTRUCTOR="Y" G_U_K="71DF3CBFD55645ECA474DD6D81F6FF00" ASSEMBLYREFS="" PROGRAM_SOURCE="using System;&#xD;&#xA;using System.Xml.XPath;&#xD;&#xA;using USoft.Net;&#xD;&#xA;&#xD;&#xA;class OTS_WIN_NETWORK&#xD;&#xA;{&#xD;&#xA;&#x9;XPathNodeIterator m_nodes;&#xD;&#xA;&#xD;&#xA;&#x9;public string HostName()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return WNetwork.HostName();&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string LocalIPAddress()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return WNetwork.LocalIPAddress();&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string DnsHostAddresses(string hostname)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n = WNetwork.DnsHostAddresses(hostname);&#xD;&#xA;&#x9;&#x9;if(!n.MoveNext())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;return string.Empty;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;return n.Current.InnerXml;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public bool IsNetworkAvailable()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return WNetwork.IsNetworkAvailable();&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string WifiAddress()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n = WNetwork.ListNetwork();&#xD;&#xA;&#x9;&#x9;if(!n.MoveNext())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;return string.Empty;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;XPathNodeIterator wifis = n.Current.Select(&quot;/NetworkInfo/Adapter[@OperationalStatus='Up'][contains(@NetworkInterfaceType, 'Wireless')]/*[contains(name(),'IPAd')]&quot;); &#xD;&#xA;&#x9;&#x9;// IPADDRESS but old version had spelling error IPAdress&#xD;&#xA;&#x9;&#x9;if(!wifis.MoveNext())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;return string.Empty;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;string address = wifis.Current.GetAttribute(&quot;Address&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;if(string.IsNullOrEmpty(address)) address = wifis.Current.GetAttribute(&quot;Adress&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;return address;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string ListNetwork()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n = WNetwork.ListNetwork();&#xD;&#xA;&#x9;&#x9;if(!n.MoveNext()) return string.Empty;&#xD;&#xA;&#x9;&#x9;return n.Current.InnerXml;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string Wifi()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n = WNetwork.wifi();&#xD;&#xA;&#x9;&#x9;if(!n.MoveNext()) return string.Empty;&#xD;&#xA;&#x9;&#x9;&#x9;return n.Current.InnerXml;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public bool WifiConnected(string ssid)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n = WNetwork.wifi();&#xD;&#xA;&#x9;&#x9;if(!n.MoveNext()) return false;&#xD;&#xA;&#x9;&#x9;XPathNodeIterator connectedwifi = n.Current.Select(string.Format(&quot;//nic[@ssid='{0}']&quot;, ssid));&#xD;&#xA;&#x9;&#x9;if(!connectedwifi.MoveNext()) return false;&#xD;&#xA;&#x9;&#x9;return true;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;// returns IPStatus (e.g. Success) followed by roundtrip time in milliseconds &#xD;&#xA;&#x9;public string Ping(string hostname)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return WNetwork.Ping(hostname);&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public int QueryExe(string dummy)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n = WNetwork.ListNetwork();&#xD;&#xA;&#x9;&#x9;if(!n.MoveNext()) return 0;&#xD;&#xA;&#x9;&#x9;m_nodes = n.Current.Select(&quot;//Adapter&quot;);&#xD;&#xA;&#x9;&#x9;return 1;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public int QueryFetch(out string name, out string status, out string interfaceType, out string description, out string IPAddress, out string GWAddress)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;name = status = interfaceType = description = IPAddress = GWAddress = string.Empty;&#xD;&#xA;&#x9;&#x9;if(!m_nodes.MoveNext()) return 0;&#xD;&#xA;&#x9;&#x9;name = m_nodes.Current.GetAttribute(&quot;Name&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;status = m_nodes.Current.GetAttribute(&quot;OperationalStatus&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;interfaceType = m_nodes.Current.GetAttribute(&quot;NetworkInterfaceType&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;description = m_nodes.Current.GetAttribute(&quot;Description&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;XPathNodeIterator itIPAddress = m_nodes.Current.Select(&quot;IPAddress&quot;);&#xD;&#xA;&#x9;&#x9;if(itIPAddress.MoveNext())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;IPAddress = itIPAddress.Current.GetAttribute(&quot;Address&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;XPathNodeIterator itGWAddress = m_nodes.Current.Select(&quot;Address&quot;);&#xD;&#xA;&#x9;&#x9;if(itGWAddress.MoveNext())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;GWAddress = itGWAddress.Current.GetAttribute(&quot;Address&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;return 1;&#xD;&#xA;&#x9;}&#xD;&#xA;}" DOTNET_ACTIVE="Y" LANGUAGE="C#" ORIGIN="" APP_DOMAIN="Default" INCLUDE_WINDOWS_APP_DLL="N" />
