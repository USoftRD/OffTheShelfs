    <T_RDMI_COMPONENT_CONSTRUCTOR COMPONENT_NAME="OTS_WIN_NETWORK" DESCRIPTION="This OTS_WIN_NETWORK component interacts with the Windows network.&#xD;&#xA;A table component OTS_WIN_NETWORK is also available to instantly query networks as records.&#xD;&#xA;Once the OTS_WIN_NETWORK component is added to the USoft Definer you can:&#xD;&#xA;&#x9;-Open the application and query the Windows Network table (i.e. the OTS_WIN_NETWORK table)&#xD;&#xA;&#x9;-Open SqlCommand in the application and use method calls.&#xD;&#xA;&#xD;&#xA;Method call examples:&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.hostname()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.DnsHostAddresses('localhost')&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.LocalIPAddress()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.WIFIADDRESS()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.IsNetworkAvailable()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.ListNetwork()&#xD;&#xA;&#xD;&#xA;invoke OTS_WIN_NETWORK.Query with select null&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.Wifi()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.wificonnected('USoftGuest')&#xD;&#xA;&#xD;&#xA;select OTS_WIN_NETWORK.ping('localhost')" T_RDMI_JAVA_COMPONENT="N" T_RDMI_STATEFUL_COMPONENT="Y" INTERFACE="N" MODULE="" INTERFACE_CORRECT="Y" T_RDMI_WEB_SERVICE_COMPONENT="N" T_RDMI_DOTNET_COMPONENT="Y" T_RDMI_COMPONENT_CONSTRUCTOR="Y" G_U_K="71DF3CBFD55645ECA474DD6D81F6FF00" CONSTRUCTOR_SQL="" ACTIVE="N" />
