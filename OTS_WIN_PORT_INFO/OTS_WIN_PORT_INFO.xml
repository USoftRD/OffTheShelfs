    <T_RDMI_DOTNET_COMPONENT COMPONENT_NAME="OTS_WIN_PORT_INFO" DESCRIPTION="The OTS_WIN_PORT_INFO retrieves port information on a windows computer.&#xD;&#xA;A table component OTS_WIN_PORT_INFO is available to query all ports in use and their status.&#xD;&#xA;Additionally, the below set of utility methods is available:&#xD;&#xA;&#xD;&#xA;select OTS_WIN_PORT_INFO.freePort()&#xD;&#xA;&#xD;&#xA;select OTS_WIN_PORT_INFO.isFreePort(80)&#xD;&#xA;&#xD;&#xA;select OTS_WIN_PORT_INFO.portdetails(80)&#xD;&#xA;&#xD;&#xA;invoke OTS_WIN_PORT_INFO.Query with select null" T_RDMI_JAVA_COMPONENT="N" T_RDMI_STATEFUL_COMPONENT="Y" INTERFACE="N" MODULE="" INTERFACE_CORRECT="Y" T_RDMI_WEB_SERVICE_COMPONENT="N" T_RDMI_DOTNET_COMPONENT="Y" T_RDMI_COMPONENT_CONSTRUCTOR="Y" G_U_K="9316F5B13E194CBBB88D1F93499818ED" ASSEMBLYREFS="" PROGRAM_SOURCE="using System;&#xD;&#xA;using USoft.Net.Util; &#xD;&#xA;using System.Xml.XPath;&#xD;&#xA;&#xD;&#xA;class OTS_WIN_PORT_INFO&#xD;&#xA;{&#xD;&#xA;&#x9;XPathNodeIterator m_nodes;&#xD;&#xA;&#xD;&#xA;&#x9;public int FreePort()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return USoft.Net.WNetwork.FreePort();&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public bool IsFreePort(int p)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return PortInfo.IsFreePort(p);&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string Portinfo()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n =  PortInfo.ports();&#xD;&#xA;&#x9;&#x9;if(n.MoveNext())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;return n.Current.InnerXml;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;return string.Empty;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string PortDetails(int p)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n =  PortInfo.portinfo(p);&#xD;&#xA;&#x9;&#x9;if(n.MoveNext())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;return n.Current.InnerXml;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;return string.Empty;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public int QueryExe(string dummy)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;XPathNodeIterator n =  PortInfo.ports();&#xD;&#xA;&#x9;&#x9;if(!n.MoveNext()) return 0;&#xD;&#xA;&#x9;&#x9;m_nodes = n.Current.Select(&quot;//TcpPort|//UdpPort&quot;);&#xD;&#xA;&#x9;&#x9;return 1;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public int QueryFetch(out string localPort, out string remotePort, out string portType, out string state, out string localAddress, out string remoteAddress, out string processName, out string processId)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;localPort = remotePort = portType = state = localAddress = remoteAddress = processName = processId = string.Empty;&#xD;&#xA;&#x9;&#x9;if(!m_nodes.MoveNext()) return 0;&#xD;&#xA;&#x9;&#x9;portType = m_nodes.Current.Name;&#xD;&#xA;&#x9;&#x9;localPort = m_nodes.Current.GetAttribute(&quot;LocalPort&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;remotePort = m_nodes.Current.GetAttribute(&quot;RemotePort&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;state = m_nodes.Current.GetAttribute(&quot;State&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;localAddress = m_nodes.Current.GetAttribute(&quot;LocalAddress&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;remoteAddress = m_nodes.Current.GetAttribute(&quot;RemoteAddress&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;processName = m_nodes.Current.GetAttribute(&quot;ProcessName&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;processId = m_nodes.Current.GetAttribute(&quot;ProcessId&quot;, string.Empty);&#xD;&#xA;&#x9;&#x9;return 1;&#xD;&#xA;&#x9;}&#xD;&#xA;}" DOTNET_ACTIVE="Y" LANGUAGE="C#" ORIGIN="" APP_DOMAIN="Default" INCLUDE_WINDOWS_APP_DLL="N" />
